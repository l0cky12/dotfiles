  // -------------------------------------------------------------- Update ---
  {
    "id": "update",
    "icon": "󰚰",
    "label": "Update",
    "title": "Update",
    "aliases": ["upgrade", "sync"]
  },
  {
    "id": "update.system",
    "icon": "󰣇",
    "label": "System packages",
    "action": "kitty -e bash -c 'yay -Syu; read -rp \"Done. Press enter.\"'"
  },
  {
    "id": "update.pending",
    "icon": "󰀦",
    "label": "Show pending updates",
    "when": "[[ -x ~/.config/hypr/scripts/arch-updates ]]",
    "action": "kitty -e bash -c '~/.config/hypr/scripts/arch-updates; read -rp \"Press enter.\"'"
  },
  {
    "id": "update.firmware",
    "icon": "󰢻",
    "label": "Firmware [UNRESOLVED]",
    "when": "command -v fwupdmgr >/dev/null",
    "action": "kitty -e bash -c 'fwupdmgr refresh && fwupdmgr get-updates; read -rp \"Press enter.\"'"
  },
  {
    "id": "update.timezone",
    "icon": "󰥔",
    "label": "Timezone",
    "title": "Timezone",
    "provider": "timezones"
  },
  {
    "id": "update.theme",
    "icon": "󰸌",
    "label": "Regenerate theme output",
    "when": "[[ -x ~/.local/bin/theme ]]",
    "action": "~/.local/bin/theme set \"$(~/.local/bin/theme current)\""
  },

  {
    "id": "update.hardware",
    "icon": "󰢻",
    "label": "Hardware",
    "title": "Restart hardware services"
  },
  {
    "id": "update.hardware.audio",
    "icon": "󰕾",
    "label": "Restart audio",
    "when": "systemctl --user list-unit-files pipewire.service >/dev/null 2>&1",
    "action": "systemctl --user restart pipewire pipewire-pulse wireplumber"
  },
  {
    "id": "update.hardware.network",
    "icon": "󰖩",
    "label": "Restart networking",
    "when": "systemctl list-unit-files NetworkManager.service >/dev/null 2>&1",
    "action": "kitty -e sudo systemctl restart NetworkManager"
  },
  {
    "id": "update.hardware.bluetooth",
    "icon": "󰂯",
    "label": "Restart Bluetooth",
    "when": "systemctl list-unit-files bluetooth.service >/dev/null 2>&1",
    "action": "kitty -e sudo systemctl restart bluetooth"
  },
  {
    "id": "update.hardware.monitors",
    "icon": "󰍹",
    "label": "Re-apply monitor profile",
    "when": "[[ -x ~/.config/hypr/scripts/auto-monitor-profile.sh ]]",
    "action": "~/.config/hypr/scripts/auto-monitor-profile.sh --force"
  },

  {
    "id": "update.process",
    "icon": "󰅗",
    "label": "Process",
    "title": "Process"
  },
  {
    "id": "update.process.kill-window",
    "icon": "󰅚",
    "label": "Force quit a window",
    "action": "hyprctl kill"
  },
  {
    "id": "update.process.activity",
    "icon": "󰄨",
    "label": "Activity monitor",
    "action": "~/.config/hypr/scripts/btop-float.sh"
  },

  {
    "id": "update.config",
    "icon": "󰒓",
    "label": "Config",
    "title": "Config"
  },
  {
    "id": "update.config.reload-hyprland",
    "icon": "󰚰",
    "label": "Reload Hyprland config",
    "action": "hyprctl reload"
  },
  {
    "id": "update.config.reload-shell",
    "icon": "󰚰",
    "label": "Reload Quickshell",
    "when": "command -v quickshell >/dev/null",
    "action": "quickshell ipc call shell reload || pkill -x quickshell"
  },

  // --------------------------------------------------------------- About ---
  {
    "id": "about",
    "icon": "󰋼",
    "label": "About",
    "title": "About",
    "aliases": ["info", "system-info"]
  },
  {
    "id": "about.system",
    "icon": "󰌢",
    "label": "System summary",
    "action": "notify-send 'System' \"$(uname -sr)\\n$(hyprctl version | head -n 1)\\nUptime:$(uptime -p | sed 's/^up//')\""
  },
  {
    "id": "about.fastfetch",
    "icon": "󰣇",
    "label": "fastfetch",
    "when": "command -v fastfetch >/dev/null",
    "action": "kitty -e bash -c 'fastfetch; read -rp \"Press enter.\"'"
  },

  // -------------------------------------------------------------- System ---
  {
    "id": "system",
    "icon": "󰐥",
    "label": "System",
    "title": "System",
    "aliases": ["power", "session"]
  },
  {
    "id": "system.screensaver",
    "icon": "󰶐",
    "label": "Screensaver",
    "when": "[[ -x ~/.local/bin/ascii-screensaver ]]",
    "action": "~/.local/bin/ascii-screensaver force"
  },
  {
    "id": "system.screensaver-branding",
    "icon": "󰏘",
    "label": "Screensaver logo",
    "title": "Screensaver logo"
  },
  {
    "id": "system.screensaver-branding.text",
    "icon": "󰊄",
    "label": "Edit text logo",
    "action": "xdg-terminal-exec ~/.local/bin/screensaver-branding text"
  },
  {
    "id": "system.screensaver-branding.image",
    "icon": "󰋩",
    "label": "Convert image from clipboard path",
    "action": "xdg-terminal-exec bash -lc '~/.local/bin/screensaver-branding image \"$(wl-paste)\"'"
  },
  {
    "id": "system.screensaver-branding.reset",
    "icon": "󰑐",
    "label": "Reset logo",
    "action": "~/.local/bin/screensaver-branding reset"
  },
  {
    "id": "system.lock",
    "icon": "󰍁",
    "label": "Lock",
    "when": "command -v hyprlock >/dev/null",
    "action": "if [[ -x ~/.local/bin/screensaver-lock ]]; then ~/.local/bin/screensaver-lock; else pidof hyprlock || hyprlock --config ~/.config/hypr/hyprlock.conf; fi"
  },
  {
    "id": "system.suspend",
    "icon": "󰤄",
    "label": "Suspend",
    "when": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.\"stay-awake\" == \"off\"' >/dev/null",
    "action": "loginctl lock-session && systemctl suspend"
  },
  {
    "id": "system.hibernate",
    "icon": "󰒲",
    "label": "Hibernate",
    "when": "grep -q disk /sys/power/state 2>/dev/null && [[ -n $(swapon --show --noheadings 2>/dev/null) ]]",
    "action": "systemctl hibernate"
  },
  {
    "id": "system.logout",
    "icon": "󰗽",
    "label": "Logout",
    "action": "hyprctl dispatch exit"
  },
  {
    "id": "system.reboot",
    "icon": "󰜉",
    "label": "Reboot",
    "action": "systemctl reboot"
  },
  {
    "id": "system.shutdown",
    "icon": "󰐥",
    "label": "Shutdown",
    "action": "systemctl poweroff"
  }
]
