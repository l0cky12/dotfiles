// lmenu default menu tree.
//
// The dotted id is the tree: "style.bar.position" is a child of "style.bar".
// Kind is inferred - "action" makes a leaf, "target" makes a link, "provider"
// makes a generated submenu, anything else is a plain submenu.
//
// Guards are bash conditions, evaluated in one batched bash process per render:
//   when      - hide the row unless the condition succeeds
//   disabled  - keep the row, dim it and tick it, but make it unselectable
//   checked   - tick the row when the condition succeeds
//
// Override or extend any of this from ~/.config/lmenu/extensions/menu.jsonc.
// Same-id entries there replace only the fields they declare and keep their
// position; new ids append.
[
  // ---------------------------------------------------------------- Apps ---
  {
    "id": "apps",
    "icon": "󰀻",
    "label": "Apps",
    "title": "Apps",
    "provider": "apps",
    "aliases": ["applications", "launcher", "drun"],
    "description": "Every installed desktop application"
  },

  // -------------------------------------------------------- Development ---
  {
    "id": "development",
    "icon": "󰅩",
    "label": "Development",
    "title": "Development",
    "aliases": ["developer", "dev", "coding"]
  },
  {
    "id": "development.docker",
    "icon": "󰡨",
    "label": "Docker environments",
    "title": "Docker environments",
    "aliases": ["containers", "compose", "databases"],
    "when": "command -v docker >/dev/null && docker compose version >/dev/null 2>&1"
  },
  {
    "id": "development.docker.mysql",
    "icon": "󰆼",
    "label": "MySQL",
    "aliases": ["database", "sql"],
    "checked": "~/.config/hypr/scripts/docker-dev-env status mysql >/dev/null 2>&1",
    "action": "~/.config/hypr/scripts/docker-dev-env toggle mysql"
  },
  {
    "id": "development.docker.postgres",
    "icon": "󰆼",
    "label": "PostgreSQL",
    "aliases": ["postgres", "database", "sql"],
    "checked": "~/.config/hypr/scripts/docker-dev-env status postgres >/dev/null 2>&1",
    "action": "~/.config/hypr/scripts/docker-dev-env toggle postgres"
  },
  {
    "id": "development.docker.mariadb",
    "icon": "󰆼",
    "label": "MariaDB",
    "aliases": ["mysql", "database", "sql"],
    "checked": "~/.config/hypr/scripts/docker-dev-env status mariadb >/dev/null 2>&1",
    "action": "~/.config/hypr/scripts/docker-dev-env toggle mariadb"
  },
  {
    "id": "development.docker.redis",
    "icon": "󰆼",
    "label": "Redis",
    "aliases": ["cache", "key value"],
    "checked": "~/.config/hypr/scripts/docker-dev-env status redis >/dev/null 2>&1",
    "action": "~/.config/hypr/scripts/docker-dev-env toggle redis"
  },
  {
    "id": "development.docker.info",
    "icon": "󰋼",
    "label": "Connection details",
    "when": "[[ -f ${XDG_STATE_HOME:-$HOME/.local/state}/docker-dev-env/environment.env ]]",
    "action": "kitty --title 'Development connections' -e bash -lc '~/.config/hypr/scripts/docker-dev-env info; read -rp \"Press Enter to close…\"'"
  },
  {
    "id": "development.docker.stop-all",
    "icon": "󰓛",
    "label": "Stop all",
    "when": "~/.config/hypr/scripts/docker-dev-env list 2>/dev/null | grep -q running",
    "action": "~/.config/hypr/scripts/docker-dev-env stop-all"
  },

  // --------------------------------------------------------------- Learn ---
  {
    "id": "learn",
    "icon": "󰋗",
    "label": "Learn",
    "title": "Learn",
    "aliases": ["help", "docs"]
  },
  {
    "id": "learn.keybindings",
    "icon": "󰌌",
    "label": "Keybindings",
    "aliases": ["binds", "shortcuts"],
    "action": "quickshell ipc call keybinds toggle"
  },
  {
    "id": "learn.hyprland",
    "icon": "󰖟",
    "label": "Hyprland wiki",
    "aliases": ["hypr", "compositor"],
    "action": "xdg-open https://wiki.hypr.land/"
  },
  {
    "id": "learn.arch",
    "icon": "󰣇",
    "label": "Arch wiki",
    "aliases": ["archlinux", "arch"],
    "action": "xdg-open https://wiki.archlinux.org/"
  },
  {
    "id": "learn.neovim",
    "icon": "󰈙",
    "label": "LazyVim docs",
    "aliases": ["neovim", "nvim", "lazyvim"],
    "action": "xdg-open https://www.lazyvim.org/"
  },
  {
    "id": "learn.bash",
    "icon": "󰅩",
    "label": "Bash",
    "aliases": ["shell", "devhints", "rico"],
    "action": "xdg-open https://devhints.io/bash"
  },

  // ------------------------------------------------------------- Trigger ---
  {
    "id": "trigger",
    "icon": "󱐋",
    "label": "Trigger",
    "title": "Trigger",
    "aliases": ["do", "actions"]
  },
  {
    "id": "trigger.emoji",
    "icon": "󰞅",
    "label": "Emoji",
    "action": "~/.config/hypr/scripts/RofiEmoji.sh"
  },

  // Countdown reminders, backed by transient systemd user timers.
  {
    "id": "trigger.reminder",
    "icon": "󰀠",
    "label": "Reminder",
    "title": "Reminder",
    "aliases": ["timer", "alarm", "remind"]
  },
  {
    "id": "trigger.reminder.set",
    "icon": "󰃭",
    "label": "Set a reminder",
    "aliases": ["new reminder", "countdown"],
    "action": "~/.local/bin/lmenu-reminder set"
  },
  {
    "id": "trigger.reminder.show",
    "icon": "󰋚",
    "label": "Show reminders",
    "aliases": ["pending", "list reminders"],
    "action": "~/.local/bin/lmenu-reminder list"
  },
  {
    "id": "trigger.reminder.clear",
    "icon": "󰅚",
    "label": "Clear all reminders",
    "aliases": ["cancel reminders"],
    "when": "[[ $(~/.local/bin/lmenu-reminder count) -gt 0 ]]",
    "action": "~/.local/bin/lmenu-reminder clear"
  },

  {
    "id": "trigger.capture",
    "icon": "󰄄",
    "label": "Capture",
    "title": "Capture",
    "aliases": ["screenshot", "record"]
  },
  {
    "id": "trigger.capture.screenshot",
    "icon": "󰆞",
    "label": "Screenshot (smart)",
    "action": "~/.config/hypr/scripts/capture/capture.sh screenshot smart"
  },
  {
    "id": "trigger.capture.region",
    "icon": "󰩬",
    "label": "Screenshot region",
    "action": "~/.config/hypr/scripts/capture/capture.sh screenshot region"
  },
  {
    "id": "trigger.capture.window",
    "icon": "󰖯",
    "label": "Screenshot window",
    "action": "~/.config/hypr/scripts/capture/capture.sh screenshot window"
  },
  {
    "id": "trigger.capture.monitor",
    "icon": "󰍹",
    "label": "Screenshot monitor",
    "action": "~/.config/hypr/scripts/capture/capture.sh screenshot monitor"
  },
  {
    "id": "trigger.capture.record",
    "icon": "󰑊",
    "label": "Start screen recording",
    "when": "! ~/.config/hypr/scripts/capture/record.sh status | grep -qx recording",
    "action": "~/.config/hypr/scripts/capture/capture.sh record menu"
  },
  {
    "id": "trigger.capture.record-stop",
    "icon": "󰙧",
    "label": "Stop screen recording",
    "when": "~/.config/hypr/scripts/capture/record.sh status | grep -qx recording",
    "action": "~/.config/hypr/scripts/capture/capture.sh record stop"
  },
  {
    "id": "trigger.capture.ocr",
    "icon": "󰦥",
    "label": "Extract text (OCR)",
    "when": "command -v tesseract >/dev/null",
    "action": "~/.config/hypr/scripts/capture/capture.sh ocr"
  },
  {
    "id": "trigger.capture.color",
    "icon": "󰸱",
    "label": "Colour picker",
    "when": "command -v hyprpicker >/dev/null && ! pgrep -x hyprpicker >/dev/null",
    "action": "~/.config/hypr/scripts/capture/capture.sh color"
  },
  {
    "id": "trigger.capture.qr",
    "icon": "󰐲",
    "label": "QR code from clipboard",
    "when": "command -v qrencode >/dev/null",
    "action": "wl-paste | qrencode -o - -t PNG | wl-copy --type image/png && notify-send 'lmenu' 'QR code copied to the clipboard'"
  },

  {
    "id": "trigger.transcode",
    "icon": "󰈫",
    "label": "Transcode",
    "aliases": ["convert", "ffmpeg", "media"],
    "action": "~/.config/hypr/scripts/transcode-menu.sh"
  },
  {
    "id": "trigger.share",
    "icon": "󰒖",
    "label": "Share",
    "title": "Share",
    "aliases": ["send"]
  },
  {
    "id": "trigger.share.clipboard",
    "icon": "󰅎",
    "label": "Copy selection to clipboard",
    "action": "~/.config/hypr/scripts/universal-clipboard.sh copy"
  },
  {
    "id": "trigger.share.file",
    "icon": "󰈔",
    "label": "Send a file",
    "when": "command -v localsend >/dev/null",
    "action": "localsend"
  },
  {
    "id": "trigger.share.receive",
    "icon": "󰇚",
    "label": "Receive a file",
    "when": "command -v localsend >/dev/null",
    "action": "localsend"
  },
  {
    "id": "trigger.share.wifi",
    "icon": "󰖩",
    "label": "Share Wi-Fi as a QR code",
    "when": "command -v qrencode >/dev/null && nmcli -t -f TYPE connection show --active | grep -q wireless",
    "action": "~/.config/hypr/scripts/network-control qr"
  },

  {
    "id": "trigger.toggle",
    "icon": "󰔡",
    "label": "Toggle",
    "title": "Toggle",
    "aliases": ["toggles", "switches"]
  },
  // Toggle rows use the existing repo commands and their established state.
  {
    "id": "trigger.toggle.stay-awake",
    "icon": "󰅶",
    "label": "Stay awake",
    "checked": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.\"stay-awake\" == \"on\"' >/dev/null",
    "action": "~/.config/hypr/scripts/toggles-menu.sh stay-awake"
  },
  {
    "id": "trigger.toggle.notifications",
    "icon": "󰂛",
    "label": "Do not disturb",
    "checked": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.dnd == \"on\"' >/dev/null",
    "action": "~/.config/hypr/scripts/toggles-menu.sh dnd"
  },
  {
    "id": "trigger.toggle.screensaver",
    "icon": "󰶐",
    "label": "Screensaver",
    "checked": "~/.local/bin/toggle-screensaver status | grep -qx 'screensaver: on'",
    "action": "~/.local/bin/toggle-screensaver"
  },
  {
    "id": "trigger.toggle.nightlight",
    "icon": "󰖔",
    "label": "Night light",
    "when": "command -v hyprsunset >/dev/null",
    "checked": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.nightlight == \"on\"' >/dev/null",
    "action": "~/.config/hypr/scripts/toggles-menu.sh nightlight"
  },
  {
    "id": "trigger.toggle.bar",
    "icon": "󰍜",
    "label": "Menu bar",
    "checked": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.bar == \"on\"' >/dev/null",
    "action": "~/.config/hypr/scripts/toggles-menu.sh bar"
  },
  {
    "id": "trigger.toggle.touchpad",
    "icon": "󰟸",
    "label": "Touchpad",
    "when": "hyprctl devices -j | jq -e '.touchpads | length > 0' >/dev/null",
    "checked": "~/.config/hypr/scripts/toggles-menu.sh status | jq -e '.touchpad == \"on\"' >/dev/null",
    "action": "~/.config/hypr/scripts/toggles-menu.sh touchpad"
  },
  {
    "id": "trigger.toggle.battery",
    "icon": "󰁹",
    "label": "Battery percentage [UNRESOLVED]",
    "when": "compgen -G '/sys/class/power_supply/BAT*' >/dev/null",
    "action": "notify-send 'lmenu' 'TODO: the Quickshell bar exposes no battery-percentage IPC yet. Point trigger.toggle.battery at one from the extensions file.'"
  },
  {
    "id": "trigger.toggle.layout",
    "icon": "󰕬",
    "label": "Workspace layout (dwindle / master)",
    "checked": "[[ $(hyprctl getoption general:layout -j | jq -r .str) == master ]]",
    "action": "~/.config/hypr/scripts/LayoutToggle.sh"
  },
  {
    "id": "trigger.toggle.gaps",
    "icon": "󰘞",
    "label": "Window gaps",
    "checked": "[[ ! -e ${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-desktop/gaps-defaults.json ]]",
    "action": "~/.config/hypr/scripts/toggle-gaps.sh"
  },
  {
    "id": "trigger.toggle.transparency",
    "icon": "󰡒",
    "label": "Window transparency",
    "checked": "[[ ! -e ${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-desktop/opacity-defaults.json ]]",
    "action": "~/.config/hypr/scripts/toggle-transparency.sh"
  },
  {
    "id": "trigger.toggle.ratio",
    "icon": "󰥃",
    "label": "1-window ratio",
    "checked": "~/.local/bin/lmenu-toggle-ratio status | grep -qx 1",
    "action": "~/.local/bin/lmenu-toggle-ratio"
  },

  {
    "id": "trigger.speedtest",
    "icon": "󰓁",
    "label": "Speed Test",
    "aliases": ["bandwidth", "network speed"],
    "when": "command -v curl >/dev/null",
    "action": "~/.local/bin/network-speedtest"
  },
  {
    "id": "trigger.calculator",
    "icon": "󰃬",
    "label": "Calculator",
    "action": "~/.config/hypr/scripts/calculator.sh"
  },
  {
    "id": "trigger.clipboard",
    "icon": "󰅍",
    "label": "Clipboard history",
    "action": "quickshell ipc call clipboard toggle"
  },
  {
    "id": "trigger.hardware",
    "icon": "󰢻",
    "label": "Hardware",
    "title": "Hardware",
    "aliases": ["devices"]
  },
  {
    "id": "trigger.hardware.monitors",
    "icon": "󰍹",
    "label": "Monitor profiles",
    "action": "~/.config/hypr/scripts/monitor-profile-menu.sh"
  },
  {
    "id": "trigger.hardware.network",
    "icon": "󰖩",
    "label": "Network panel",
    "action": "quickshell ipc call network toggle"
  },
  {
    "id": "trigger.hardware.bluetooth",
    "icon": "󰂯",
    "label": "Bluetooth panel",
    "action": "quickshell ipc call bluetooth toggle"
  },
  {
    "id": "trigger.hardware.audio",
    "icon": "󰕾",
    "label": "Audio panel",
    "action": "quickshell ipc call audio toggle"
  },
  {
    "id": "trigger.hardware.power-profile",
    "icon": "󰓅",
    "label": "Power profile",
    "action": "~/.config/hypr/scripts/power-profile.sh menu"
  },
  {
    "id": "trigger.hardware.eject",
    "icon": "󰇙",
    "label": "Eject removable drives",
    "action": "~/.config/hypr/scripts/eject-drive.sh"
  },
  {
    "id": "trigger.hardware.activity",
    "icon": "󰄨",
    "label": "Activity (btop)",
    "action": "~/.config/hypr/scripts/btop-float.sh"
  },

  // --------------------------------------------------------------- Style ---
  {
    "id": "style",
    "icon": "󰉼",
    "label": "Style",
    "title": "Style",
    "aliases": ["appearance", "look"]
  },
  {
    "id": "style.theme",
    "icon": "󰸌",
    "label": "Theme",
    "title": "Theme",
    "provider": "themes",
    "aliases": ["themes", "colours", "colors"]
  },
  {
    "id": "style.background",
    "icon": "󰸉",
    "label": "Background",
    "aliases": ["wallpaper", "wallpapers"],
    "action": "~/.local/bin/hypr-wallpaper-picker"
  },
  {
    "id": "style.font",
    "icon": "󰛖",
    "label": "Font",
    "title": "Font",
    "provider": "fonts",
    "aliases": ["fonts"]
  },
  {
    "id": "style.bar",
    "icon": "󰍜",
    "label": "Menu bar",
    "title": "Menu bar"
  },
  {
    "id": "style.bar.toggle",
    "icon": "󰔡",
    "label": "Show or hide the bar",
    "action": "~/.config/hypr/scripts/toggles-menu.sh bar"
  },
  {
    "id": "style.bar.position",
    "icon": "󰤻",
    "label": "Bar position [UNRESOLVED]",
    "action": "notify-send 'lmenu' 'TODO: the Quickshell bar has no position setting yet. Add one and point style.bar.position at it.'"
  },
  {
    "id": "style.bar.transparency",
    "icon": "󰡒",
    "label": "Bar transparency [UNRESOLVED]",
    "action": "notify-send 'lmenu' 'TODO: the Quickshell bar has no transparency setting yet.'"
  },
  {
    "id": "style.hyprland",
    "icon": "󰒓",
    "label": "Hyprland look and feel",
    "when": "[[ -f ~/.config/hypr/conf/decorations.lua ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/conf/decorations.lua"
  },
  {
    "id": "style.transparency",
    "icon": "󰡔",
    "label": "Toggle window transparency",
    "action": "~/.config/hypr/scripts/toggle-transparency.sh"
  },
  {
    "id": "style.gaps",
    "icon": "󰘞",
    "label": "Toggle window gaps",
    "action": "~/.config/hypr/scripts/toggle-gaps.sh"
  },

  // --------------------------------------------------------------- Setup ---
  {
    "id": "setup",
    "icon": "󰒓",
    "label": "Setup",
    "title": "Setup",
    "aliases": ["config", "configure", "settings"]
  },
  {
    "id": "setup.monitors",
    "icon": "󰍹",
    "label": "Monitors",
    "when": "[[ -f ~/.config/hypr/monitors.lua ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/monitors.lua"
  },
  {
    "id": "setup.keybindings",
    "icon": "󰌌",
    "label": "Keybindings",
    "when": "[[ -f ~/.config/hypr/conf/keybinding.conf ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/conf/keybinding.conf"
  },
  {
    "id": "setup.input",
    "icon": "󰌌",
    "label": "Input",
    "when": "[[ -f ~/.config/hypr/hyprland.conf ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/hyprland.conf"
  },
  {
    "id": "setup.workspaces",
    "icon": "󰕰",
    "label": "Workspaces",
    "when": "[[ -f ~/.config/hypr/workspaces.lua ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/workspaces.lua"
  },
  {
    "id": "setup.window-rules",
    "icon": "󰖯",
    "label": "Window rules",
    "when": "[[ -f ~/.config/hypr/conf/window_rules.lua ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/conf/window_rules.lua"
  },
  {
    "id": "setup.autostart",
    "icon": "󰐊",
    "label": "Autostart",
    "when": "[[ -f ~/.config/hypr/conf/autostart.lua ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/conf/autostart.lua"
  },

  {
    "id": "setup.network",
    "icon": "󰖩",
    "label": "Network",
    "title": "Network"
  },
  {
    "id": "setup.network.manage",
    "icon": "󰤨",
    "label": "Manage connections",
    "action": "quickshell ipc call network manage"
  },
  {
    "id": "setup.network.dns",
    "icon": "󰇧",
    "label": "DNS",
    "title": "DNS"
  },
  {
    "id": "setup.network.dns.dhcp",
    "icon": "󰇚",
    "label": "Automatic (DHCP)",
    "checked": "! resolvectl status 2>/dev/null | grep -q '1.1.1.1\\|8.8.8.8'",
    "action": "~/.config/hypr/scripts/network-control dns automatic"
  },
  {
    "id": "setup.network.dns.cloudflare",
    "icon": "󰅟",
    "label": "Cloudflare (1.1.1.1)",
    "checked": "resolvectl status 2>/dev/null | grep -q '1.1.1.1'",
    "action": "~/.config/hypr/scripts/network-control dns custom '1.1.1.1,1.0.0.1'"
  },
  {
    "id": "setup.network.dns.google",
    "icon": "󰊭",
    "label": "Google (8.8.8.8)",
    "checked": "resolvectl status 2>/dev/null | grep -q '8.8.8.8'",
    "action": "~/.config/hypr/scripts/network-control dns custom '8.8.8.8,8.8.4.4'"
  },
  {
    "id": "setup.network.dns.custom",
    "icon": "󰏫",
    "label": "Custom…",
    "action": "kitty -e ~/.config/hypr/scripts/network-control nmtui"
  },
  {
    "id": "setup.network.wifi-qr",
    "icon": "󰐲",
    "label": "Share Wi-Fi as a QR code",
    "when": "command -v qrencode >/dev/null && nmcli -t -f TYPE connection show --active | grep -q wireless",
    "action": "~/.config/hypr/scripts/network-control qr"
  },

  {
    "id": "setup.defaults",
    "icon": "󰓾",
    "label": "Defaults",
    "title": "Default applications"
  },
  {
    "id": "setup.defaults.browser",
    "icon": "󰖟",
    "label": "Browser",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/mimeapps.list"
  },
  {
    "id": "setup.defaults.editor",
    "icon": "󰏫",
    "label": "Editor",
    "action": "kitty -e ${EDITOR:-nvim} ~/.zshrc"
  },
  {
    "id": "setup.defaults.terminal",
    "icon": "󰄛",
    "label": "Terminal",
    "when": "[[ -f ~/.config/hypr/conf/var.conf ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/conf/var.conf"
  },
  {
    "id": "setup.defaults.mime",
    "icon": "󰈙",
    "label": "File associations",
    "when": "[[ -f ~/.config/mimeapps.list ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/mimeapps.list"
  },
  {
    "id": "setup.defaults.agent",
    "icon": "󰚩",
    "label": "Coding agent",
    "when": "[[ -f ~/.config/ai-agent/config ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/ai-agent/config"
  },

  {
    "id": "setup.security",
    "icon": "󰌾",
    "label": "Security",
    "title": "Security"
  },
  {
    "id": "setup.security.yubikey",
    "icon": "󰌆",
    "label": "YubiKey",
    "when": "command -v yubikey-auth >/dev/null",
    "action": "kitty -e yubikey-auth status"
  },
  {
    "id": "setup.security.lock",
    "icon": "󰍁",
    "label": "Lock screen settings",
    "when": "[[ -f ~/.config/hypr/hyprlock.conf ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/hyprlock.conf"
  },
  {
    "id": "setup.security.idle",
    "icon": "󰒲",
    "label": "Idle settings",
    "when": "[[ -f ~/.config/hypr/hypridle.conf ]]",
    "action": "kitty -e ${EDITOR:-nvim} ~/.config/hypr/hypridle.conf"
  },

  {
    "id": "setup.webapps",
    "icon": "󰀻",
    "label": "Web apps",
    "when": "command -v webapp >/dev/null",
    "action": "quickshell ipc call webapps toggle"
  },

