*.bak-lockfix

# ── Generated by hypr/.config/hypr/theme/generate.py ────────────────────────
# Regenerate with `theme set <slug>` after stowing. These are rendered from
# theme/templates/* plus the active palette; the templates are the source of
# truth, and these files are rewritten on every theme switch.
hypr/.config/hypr/conf/decorations.conf
hypr/.config/hypr/themes/.active/
kitty/.config/kitty/theme/current-theme.conf
swaync/.config/swaync/style.css
wofi/.config/wofi/style.css
waybar/.config/waybar/colors.css
rofi/.config/rofi/color-themes/current.rasi
rofi/.config/rofi/current-theme.rasi
zsh/.config/zsh/current-theme.zsh
hyprlock/.config/hyprlock/colors.conf
noctalia/.config/noctalia/colors.json

# Per-slug rofi colour copies written by generate.py's link_rofi()
rofi/.config/rofi/color-themes/*.rasi

# Active-theme state file (STATE_FILE), rewritten on every `theme set`
hypr/.config/hypr/themes/current-theme

# Python
**/__pycache__/
*.pyc
