*.bak
*.bak-lockfix
.qmlls.ini

# ── Generated theme outputs ───────────────────────────────────────────────────
# Sources of truth are hypr/.config/hypr/themes/<slug>/colors.toml plus the
# generator and templates in hypr/.config/hypr/theme/. Everything below is
# derived from those by `theme set <slug>`, so it is not tracked -- a fresh
# clone runs `theme set <slug>` once to materialise it.
hypr/.config/hypr/conf/decorations.conf
hypr/.config/hypr/conf/decorations.lua
hypr/.config/hypr/themes/.active/
hypr/.config/hypr/themes/current-theme
kitty/.config/kitty/theme/
rofi/.config/rofi/color-themes/
rofi/.config/rofi/current-theme.rasi
rofi/.config/rofi/powermenu/theme.rasi
hyprlock/.config/hyprlock/colors.conf
hyprlock/.config/hyprlock/layouts/colors.conf
swaync/.config/swaync/style.css
wofi/.config/wofi/style.css
greeter/.config/greeter/greeter.css
greeter/.config/greeter/regreet.toml
neovim/.config/nvim/colors/*.lua
btop/.config/btop/themes/*.theme
obsidian/.config/obsidian/snippets/generated-theme.css

# ── Generated monitor/workspace state ─────────────────────────────────────────
# Sources of truth are hypr/.config/hypr/monitor_profiles/<profile>.*.lua.
# scripts/auto-monitor-profile.sh copies the matching pair over the files below
# on every connected-output change, and nwg-displays rewrites them too, so they
# are machine state rather than configuration. A fresh clone materialises them
# with `~/.config/hypr/scripts/auto-monitor-profile.sh --force`.
hypr/.config/hypr/monitors.lua
hypr/.config/hypr/workspaces.lua
hypr/.config/hypr/monitors.conf
hypr/.config/hypr/workspaces.conf

# ── Dictation microphone selection ────────────────────────────────────────────
# scripts/voice-dictation writes the chosen PipeWire source here whenever you
# pick one, and the node name it stores is specific to one machine's hardware.
# A fresh clone leaves this absent, which the script reads as "follow the
# default audio output"; `voice-dictation choose` materialises it.
hypr/.config/hypr/voice-dictation.json

# ── Oh My Zsh ─────────────────────────────────────────────────────────────────
# Installed by the user, not vendored here: its own .gitignore excludes custom/,
# so a submodule could never carry the powerlevel10k theme or the fzf-tab plugin
# that .zshrc depends on. See README "Shell" for the three install commands.
zsh/.oh-my-zsh/

# Python bytecode from the theme generator
__pycache__/
*.pyc

# ── Runtime and host-only state ───────────────────────────────────────────────
# ~/.config/herdr is a folded Stow symlink into this repository, so herdr writes
# its logs, live session, cached release notes, lock, and sockets straight into
# the package. They describe one machine's running session, not configuration;
# herdr recreates each of them on start. config.toml stays tracked.
*.log
*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
