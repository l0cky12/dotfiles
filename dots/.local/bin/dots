#!/usr/bin/env bash

set -euo pipefail

program=${0##*/}
dry_run=false
deploy_system=false
deploy_all=false
assume_yes=false
declare -a requested_manual_packages=()

usage() {
  cat <<EOF
Usage: $program deploy [--dry-run] [--system --yes] [--all]
                       [--no-folding-pkg PACKAGE]

Deploy changed GNU Stow packages from ~/dotfiles.

  --dry-run  Print the deployment plan without changing anything
  --system   Also install the repository's greetd and PAM templates (requires --yes)
  --yes      Confirm overwriting system files when used with --system
  --all      Restow every package, including packages requiring manual Stow options
  --no-folding-pkg PACKAGE
             Explicitly deploy neovim, btop, obsidian, or wallpaper safely
EOF
}

fail() {
  printf '%s: error: %s\n' "$program" "$*" >&2
  exit 1
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

command_name=$1
shift
[[ $command_name == deploy ]] || {
  printf '%s: unknown command: %s\n' "$program" "$command_name" >&2
  usage >&2
  exit 2
}

while (($# > 0)); do
  case $1 in
    --dry-run) dry_run=true ;;
    --system) deploy_system=true ;;
    --all) deploy_all=true ;;
    --yes) assume_yes=true ;;
    --no-folding-pkg)
      (($# >= 2)) || fail "--no-folding-pkg requires a package name"
      requested_manual_packages+=("$2")
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      printf '%s: unknown option: %s\n' "$program" "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ $deploy_system == true && $assume_yes != true ]]; then
  fail "--system requires explicit confirmation with --yes"
fi

command -v git >/dev/null 2>&1 || fail "git is required"

repo=${DOTS_REPO:-"$HOME/dotfiles"}
state_file=${DOTS_STATE_FILE:-"${XDG_STATE_HOME:-$HOME/.local/state}/dots/last-deployed"}
[[ -d $repo ]] || fail "repository not found: $repo"
git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  fail "not a Git repository: $repo"

head_sha=$(git -C "$repo" rev-parse --verify HEAD^{commit}) ||
  fail "cannot resolve HEAD in $repo"

is_excluded() {
  case $1 in
    docs|wiki|tests|system|dotfiles|neovim|btop|obsidian|wallpaper) return 0 ;;
    *) return 1 ;;
  esac
}

is_manual_package() {
  case $1 in
    neovim|btop|obsidian|wallpaper) return 0 ;;
    *) return 1 ;;
  esac
}

uses_no_folding() {
  case $1 in
    neovim|btop|obsidian) return 0 ;;
    *) return 1 ;;
  esac
}

declare -a all_packages=()
declare -a manual_packages=()
declare -A is_package=()
git -C "$repo" ls-tree -d --name-only HEAD >/dev/null ||
  fail "cannot list packages in $repo"
while IFS= read -r -d '' directory; do
  if is_manual_package "$directory"; then
    manual_packages+=("$directory")
    is_package["$directory"]=1
  elif ! is_excluded "$directory"; then
    all_packages+=("$directory")
    is_package["$directory"]=1
  fi
done < <(git -C "$repo" ls-tree -z -d --name-only HEAD)

declare -A requested_manual=()
for package in "${requested_manual_packages[@]}"; do
  is_manual_package "$package" ||
    fail "--no-folding-pkg only accepts neovim, btop, obsidian, or wallpaper (got '$package')"
  [[ -n ${is_package["$package"]+present} ]] ||
    fail "package not found in repository: $package"
  requested_manual["$package"]=1
done

first_deploy=false
last_sha=
if [[ -f $state_file ]]; then
  IFS= read -r last_sha < "$state_file" || true
  [[ -n $last_sha ]] || fail "deployment state is empty: $state_file"
  git -C "$repo" rev-parse --verify --quiet "${last_sha}^{commit}" >/dev/null ||
    fail "deployment state does not name a commit: $last_sha"
else
  first_deploy=true
fi

declare -a packages=()
if [[ $deploy_all == true ]]; then
  packages=("${all_packages[@]}")
  packages+=("${manual_packages[@]}")
elif [[ $first_deploy == true ]]; then
  packages=("${all_packages[@]}")
else
  declare -A changed_packages=()
  git -C "$repo" diff --name-only "$last_sha" HEAD -- >/dev/null ||
    fail "cannot compare $last_sha with HEAD"
  while IFS= read -r -d '' path; do
    top=${path%%/*}
    if [[ $path == */* && -n ${is_package["$top"]+present} ]]; then
      changed_packages["$top"]=1
    fi
  done < <(git -C "$repo" diff --name-only -z "$last_sha" HEAD --)

  for package in "${all_packages[@]}"; do
    if [[ -n ${changed_packages["$package"]+present} ]]; then
      packages+=("$package")
    fi
  done
fi

if [[ $deploy_all != true ]]; then
  for package in "${manual_packages[@]}"; do
    if [[ -n ${requested_manual["$package"]+present} ]]; then
      packages+=("$package")
    fi
  done
fi

printf 'Repository: %s\n' "$repo"
printf 'Target commit: %s\n' "$head_sha"
if [[ $first_deploy == true ]]; then
  printf 'Notice: no previous deployment record; deploying all packages.\n'
elif [[ $deploy_all == true ]]; then
  printf 'Notice: --all selected; deploying all packages.\n'
else
  printf 'Previous commit: %s\n' "$last_sha"
fi
if [[ $deploy_all != true ]]; then
  for package in "${manual_packages[@]}"; do
    if [[ -z ${requested_manual["$package"]+present} ]]; then
      printf 'Notice: %s skipped: requires manual stow - see README.\n' "$package"
    fi
  done
fi

printf 'Packages:\n'
if ((${#packages[@]} == 0)); then
  printf '  (none)\n'
else
  for package in "${packages[@]}"; do
    printf '  - %s\n' "$package"
  done
fi

printf 'Actions:\n'
for package in "${packages[@]}"; do
  if uses_no_folding "$package"; then
    printf '  - stow --restow --no-folding --target %q %q\n' "$HOME" "$package"
  elif [[ $package == wallpaper ]]; then
    printf '  - stow --restow --target %q %q\n' "$HOME/Pictures/Wallpapers" "$package"
  else
    printf '  - stow --restow --target %q %q\n' "$HOME" "$package"
  fi
done
if [[ -n ${is_package[hypr]+present} ]]; then
  for package in "${packages[@]}"; do
    if [[ $package == hypr ]]; then
      printf '  - reload Hyprland if a session is live\n'
      break
    fi
  done
fi
if [[ $deploy_system == true ]]; then
  system_root=${DOTS_SYSTEM_ROOT:-}
  greetd_target="$system_root/etc/greetd/config.toml"
  pam_target_dir="$system_root/etc/pam.d"
  printf 'Warning: system/pam.d templates hardcode host identity pam://Kelper.\n'
  printf '  - sudo mkdir -p %s\n' "${greetd_target%/*}"
  if [[ -e $greetd_target ]]; then
    printf '  - back up existing %s before overwrite\n' "$greetd_target"
  fi
  printf '  - sudo install -m 0644 system/greetd/config.toml %s\n' "$greetd_target"
  for pam_file in "$repo"/system/pam.d/*; do
    [[ -f $pam_file ]] || fail "no PAM templates found in $repo/system/pam.d"
    pam_target="$pam_target_dir/${pam_file##*/}"
    if [[ -e $pam_target ]]; then
      printf '  - back up existing %s before overwrite\n' "$pam_target"
    fi
    printf '  - sudo install -m 0644 %s %s\n' \
      "${pam_file#"$repo"/}" "$pam_target"
  done
fi
if ((${#packages[@]} == 0)) && [[ $deploy_system == false ]]; then
  printf '  (state record only; no package changes)\n'
fi

if [[ $dry_run == true ]]; then
  printf 'Dry run: no changes made.\n'
  exit 0
fi

if ((${#packages[@]} > 0)); then
  command -v stow >/dev/null 2>&1 || fail "stow is required to deploy packages"
fi
if [[ $deploy_system == true ]]; then
  command -v sudo >/dev/null 2>&1 || fail "sudo is required with --system"
  [[ -f $repo/system/greetd/config.toml ]] ||
    fail "missing system template: $repo/system/greetd/config.toml"
fi

reload_hypr=false
for package in "${packages[@]}"; do
  if [[ $package == hypr ]]; then
    command -v pgrep >/dev/null 2>&1 ||
      fail "pgrep is required to check for a live Hyprland session"
    if pgrep -x Hyprland >/dev/null 2>&1; then
      command -v hyprctl >/dev/null 2>&1 ||
        fail "Hyprland is live but hyprctl is unavailable"
      reload_hypr=true
    fi
    break
  fi
done

for package in "${packages[@]}"; do
  printf 'Restowing %s...\n' "$package"
  declare -a stow_args=(--restow)
  if uses_no_folding "$package"; then
    stow_args+=(--no-folding --target "$HOME")
  elif [[ $package == wallpaper ]]; then
    stow_args+=(--target "$HOME/Pictures/Wallpapers")
  else
    stow_args+=(--target "$HOME")
  fi
  stow_args+=("$package")
  if ! (cd "$repo" && stow "${stow_args[@]}"); then
    fail "stow failed for '$package'; resolve the reported conflict and retry (files were not adopted or overwritten)"
  fi
done

if [[ $deploy_system == true ]]; then
  timestamp=$(date -u +%Y%m%dT%H%M%S%NZ)
  declare -a system_sources=("$repo/system/greetd/config.toml")
  declare -a system_targets=("$greetd_target")
  for pam_file in "$repo"/system/pam.d/*; do
    [[ -f $pam_file ]] || fail "no PAM templates found in $repo/system/pam.d"
    system_sources+=("$pam_file")
    system_targets+=("$pam_target_dir/${pam_file##*/}")
  done

  declare -a system_backups=()
  for target in "${system_targets[@]}"; do
    backup=
    if [[ -e $target ]]; then
      backup="${target}.pre-dots.${timestamp}"
      suffix=2
      while [[ -e $backup ]]; do
        backup="${target}.pre-dots.${timestamp}.${suffix}"
        suffix=$((suffix + 1))
      done
      sudo cp -a -- "$target" "$backup" || fail "could not back up $target"
      printf 'Backup: %s -> %s\n' "$target" "$backup"
    fi
    system_backups+=("$backup")
  done

  printf 'Rollback instructions:\n'
  for index in "${!system_targets[@]}"; do
    target=${system_targets[$index]}
    backup=${system_backups[$index]}
    if [[ -n $backup ]]; then
      printf '  sudo cp -a -- %q %q\n' "$backup" "$target"
    else
      printf '  sudo rm -f -- %q  # target did not previously exist\n' "$target"
    fi
  done

  sudo mkdir -p -- "${greetd_target%/*}" || fail "could not create ${greetd_target%/*}"
  for index in "${!system_sources[@]}"; do
    sudo install -m 0644 "${system_sources[$index]}" "${system_targets[$index]}" ||
      fail "could not install ${system_targets[$index]}"
  done
fi

if [[ $reload_hypr == true ]]; then
  printf 'Reloading Hyprland...\n'
  hyprctl reload || fail "hyprctl reload failed"
fi

state_dir=${state_file%/*}
if [[ $state_dir == "$state_file" ]]; then
  state_dir=.
fi
if [[ ! -d $state_dir ]]; then
  old_umask=$(umask)
  umask 077
  mkdir -p "$state_dir"
  umask "$old_umask"
  chmod 0700 "$state_dir"
fi
state_tmp=$(mktemp "$state_dir/.last-deployed.XXXXXX") ||
  fail "cannot create deployment state in $state_dir"
trap 'rm -f "$state_tmp"' EXIT
printf '%s\n' "$head_sha" > "$state_tmp"
chmod 0600 "$state_tmp"
mv -f "$state_tmp" "$state_file"
trap - EXIT

printf 'Deployed %s and updated %s.\n' "$head_sha" "$state_file"
