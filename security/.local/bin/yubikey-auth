#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
ACTION=
DEVICE=
MODE=auto
ENROLL_FINGERPRINT=false
WITH_HYPRLOCK=false
DRY_RUN=false
CONFIRM_SUDO_TESTED=false

AUTH_USER=${YUBIKEY_AUTH_USER:-${SUDO_USER:-${USER:-liam}}}
AUTH_ORIGIN=${YUBIKEY_AUTH_ORIGIN:-pam://Kelper}
ETC_ROOT=${YUBIKEY_AUTH_ETC_ROOT:-/etc}
MAPPING_FILE="$ETC_ROOT/u2f_mappings"
SUDO_PAM="$ETC_ROOT/pam.d/sudo"
DOAS_PAM="$ETC_ROOT/pam.d/doas"
HYPRLOCK_PAM="$ETC_ROOT/pam.d/hyprlock"

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd)
repo_root=$(cd -- "$script_dir/../../.." && pwd)
TEMPLATE_DIR=${YUBIKEY_AUTH_TEMPLATE_DIR:-$repo_root/system/pam.d}

FIDO2_TOKEN=${YUBIKEY_AUTH_FIDO2_TOKEN:-fido2-token}
PAMU2FCFG=${YUBIKEY_AUTH_PAMU2FCFG:-pamu2fcfg}
SUDO=${YUBIKEY_AUTH_SUDO:-$(command -v sudo >/dev/null 2>&1 && echo sudo || echo doas)}

usage() {
  cat <<EOF
Usage:
  $PROGRAM setup [OPTIONS]   register the first key or enable Hyprlock later
  $PROGRAM add [OPTIONS]     append another key to the existing user mapping
  $PROGRAM remove [--dry-run] revoke the last registered key from this host
  $PROGRAM status            show dependencies, token, mapping, and PAM state

Options:
  --device PATH              use this FIDO device instead of auto-detection
  --mode auto|touch|bio|pin  registration verification mode (default: auto)
  --enroll-fingerprint       enroll a fingerprint before Bio registration
  --with-hyprlock            also put the key in the lock-screen PAM stack
  --confirm-sudo-tested      deploy Hyprlock without the interactive checkpoint
  --dry-run                  report actions without changing token or system state
  -h, --help                 show this help

Modes are checked against what the key reports it can actually do:
  touch  a tap proves the key is present; no PIN and no fingerprint
  bio    the key's own fingerprint sensor verifies the user
  pin    the key's FIDO PIN is entered at every authentication
  auto   bio when the key has a sensor, otherwise touch

Hyprlock is opt-in because a touch-only credential cannot tell who tapped the
key. Anyone at the machine could unlock it while the key is plugged in.

Examples:
  $PROGRAM setup
  $PROGRAM add --device /dev/hidraw1 --mode pin
  $PROGRAM remove
  $PROGRAM setup --with-hyprlock --mode bio --enroll-fingerprint
EOF
}

fail() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

run_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  else
    "$SUDO" "$@"
  fi
}

device_listing=
detect_device() {
  device_listing=$($FIDO2_TOKEN -L 2>&1) || fail "could not list FIDO devices"

  if [[ -n $DEVICE ]]; then
    grep -Fq -- "$DEVICE:" <<<"$device_listing" \
      || fail "requested device is not a visible FIDO token: $DEVICE"
    return
  fi

  local -a devices=()
  mapfile -t devices < <(awk -F: '/Yubico|vendor=0x1050/ { print $1 }' <<<"$device_listing")
  case ${#devices[@]} in
    0) fail "no YubiKey FIDO device found" ;;
    1) DEVICE=${devices[0]} ;;
    *)
      printf '%s\n' "$device_listing" >&2
      fail "multiple YubiKeys found; select the new one with --device PATH"
      ;;
  esac
}

device_options=

# The USB product ID does not say whether a key has a fingerprint sensor:
# 0x0402 is the plain YubiKey FIDO interface, shared with keys that have no
# sensor at all. Ask the authenticator what it supports instead. Returns
# non-zero rather than exiting, so `status` can survey every attached token
# without one unreadable key aborting the whole report.
probe_device() {
  local info
  device_options=
  info=$("$FIDO2_TOKEN" -I "$DEVICE" 2>/dev/null) || return 1
  device_options=$(awk -F'options: *' '/^options:/ { print $2; exit }' <<<"$info")
  [[ -n $device_options ]]
}

# An option the key does not implement is absent; one it implements but has not
# configured is prefixed with "no". A key with an unenrolled sensor reports
# "nobioEnroll", which is exactly when --enroll-fingerprint is useful.
device_has_option() {
  local options=",${device_options// /},"
  [[ $options == *",$1,"* ]]
}

device_supports_option() {
  device_has_option "$1" || device_has_option "no$1"
}

resolve_mode() {
  case $MODE in
    auto)
      if device_supports_option bioEnroll; then
        MODE=bio
      else
        MODE='touch'
      fi
      ;;
    bio)
      device_supports_option bioEnroll \
        || fail "$DEVICE has no fingerprint sensor; use --mode touch or --mode pin"
      ;;
    pin)
      device_supports_option clientPin \
        || fail "$DEVICE does not support a FIDO PIN; use --mode touch"
      ;;
    touch) ;;
    *) fail "invalid mode '$MODE' (expected auto, touch, bio, or pin)" ;;
  esac
}

mapping_is_valid() {
  local file=$1
  [[ -s $file ]] || return 1
  ! LC_ALL=C grep -q '[[:cntrl:]]' "$file" || return 1
  awk -F: -v user="$AUTH_USER" '
    NR == 1 && $1 == user && NF >= 2 {
      ok = 1
      for (i = 2; i <= NF; i++) if (index($i, ",") == 0) ok = 0
    }
    END { exit !(NR == 1 && ok) }
  ' "$file"
}

credential_is_valid() {
  local file=$1
  [[ -s $file ]] || return 1
  ! LC_ALL=C grep -q '[[:cntrl:]]' "$file" || return 1
  awk 'NR == 1 && index($0, ":") == 0 && index($0, ",") > 0 { ok = 1 }
       END { exit !(NR == 1 && ok) }' "$file"
}

backup_file() {
  local target=$1 stamp=$2
  [[ -e $target ]] || return 0
  local base="${target}.pre-yubikey.${stamp}"
  local backup=$base suffix=2
  while [[ -e $backup ]]; do
    backup="${base}.${suffix}"
    suffix=$((suffix + 1))
  done
  run_root cp -a -- "$target" "$backup"
  printf 'backup: %s\n' "$backup"
}

install_file() {
  local source=$1 target=$2 mode=$3
  run_root install -o root -g root -m "$mode" "$source" "$target"
}

complete_setup() {
  printf '\nTest every escalation path in another terminal before continuing:\n'
  printf '  1. sudo -k; sudo -v       # press Enter, then touch the key\n'
  printf '  2. doas -L; doas true     # press Enter, then touch the key\n'
  printf '  3. repeat both with the account password, with the key inserted\n\n'

  if [[ $WITH_HYPRLOCK == false ]]; then
    printf 'Setup complete. Hyprlock still asks for the account password.\n'
    printf 'Add the key there with: %s setup --with-hyprlock\n' "$PROGRAM"
    return
  fi

  if [[ $MODE == touch ]]; then
    printf 'Warning: a touch-only key on the lock screen means anyone at this\n'
    printf 'machine can unlock it with a tap while the key is plugged in.\n\n'
  fi

  if [[ $CONFIRM_SUDO_TESTED == false ]]; then
    [[ -t 0 ]] || fail "interactive confirmation unavailable; rerun with --confirm-sudo-tested after testing sudo"
    read -r -p "Type INSTALL HYPRLOCK after both tests pass: " confirmation
    [[ $confirmation == "INSTALL HYPRLOCK" ]] \
      || fail "Hyprlock PAM was not changed"
  fi

  backup_file "$HYPRLOCK_PAM" "$stamp"
  install_file "$TEMPLATE_DIR/hyprlock" "$HYPRLOCK_PAM" 0644
  printf 'installed: %s\n' "$HYPRLOCK_PAM"
  printf 'Setup complete. At Hyprlock, press Enter before using the key.\n'
}

show_status() {
  local failed=0
  for command_name in "$FIDO2_TOKEN" "$PAMU2FCFG" "$SUDO"; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf 'ok: command %s\n' "$command_name"
    else
      printf 'missing: command %s\n' "$command_name"
      failed=1
    fi
  done

  if device_listing=$($FIDO2_TOKEN -L 2>/dev/null) && [[ -n $device_listing ]]; then
    printf 'tokens:\n%s\n' "$device_listing"
    # Shadowed so surveying every token does not leak into the caller's DEVICE.
    local token_path DEVICE
    while read -r token_path; do
      [[ -n $token_path ]] || continue
      DEVICE=$token_path
      if probe_device 2>/dev/null; then
        local capabilities='touch'
        if device_supports_option bioEnroll; then capabilities+=', fingerprint'; fi
        if device_supports_option clientPin; then capabilities+=', PIN'; fi
        printf 'verification: %s can offer %s\n' "$token_path" "$capabilities"
      fi
    done < <(awk -F: '{ print $1 }' <<<"$device_listing")
  else
    printf 'tokens: none visible\n'
    failed=1
  fi

  if [[ -r $MAPPING_FILE ]]; then
    if mapping_is_valid "$MAPPING_FILE"; then
      printf 'mapping: valid for %s (%s)\n' "$AUTH_USER" "$MAPPING_FILE"
    else
      printf 'mapping: invalid (%s)\n' "$MAPPING_FILE"
      failed=1
    fi
  elif [[ -e $MAPPING_FILE ]]; then
    printf 'mapping: present and protected (%s)\n' "$MAPPING_FILE"
  else
    printf 'mapping: absent (%s)\n' "$MAPPING_FILE"
    failed=1
  fi

  for pair in "$TEMPLATE_DIR/sudo:$SUDO_PAM" "$TEMPLATE_DIR/doas:$DOAS_PAM"; do
    local template=${pair%%:*} active=${pair#*:}
    if [[ -r $template && -r $active ]] && cmp -s -- "$template" "$active"; then
      printf 'pam: deployed %s\n' "$active"
    else
      printf 'pam: not deployed or differs %s\n' "$active"
      failed=1
    fi
  done

  # Hyprlock is opt-in, so leaving it on the password stack is a valid state
  # rather than an incomplete setup.
  if [[ -r $TEMPLATE_DIR/hyprlock && -r $HYPRLOCK_PAM ]] \
    && cmp -s -- "$TEMPLATE_DIR/hyprlock" "$HYPRLOCK_PAM"; then
    printf 'pam: deployed %s\n' "$HYPRLOCK_PAM"
  else
    printf 'pam: password only (opt in with --with-hyprlock) %s\n' "$HYPRLOCK_PAM"
  fi

  return "$failed"
}

while (($#)); do
  case $1 in
    setup|add|remove|status)
      [[ -z $ACTION ]] || fail "only one action may be specified"
      ACTION=$1
      shift
      ;;
    --device)
      (($# >= 2)) || fail "--device requires a path"
      DEVICE=$2
      shift 2
      ;;
    --device=*) DEVICE=${1#*=}; shift ;;
    --mode)
      (($# >= 2)) || fail "--mode requires auto, bio, or pin"
      MODE=$2
      shift 2
      ;;
    --mode=*) MODE=${1#*=}; shift ;;
    --enroll-fingerprint) ENROLL_FINGERPRINT=true; shift ;;
    --with-hyprlock) WITH_HYPRLOCK=true; shift ;;
    --confirm-sudo-tested) CONFIRM_SUDO_TESTED=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

[[ -n $ACTION ]] || { usage >&2; exit 2; }
[[ $WITH_HYPRLOCK == false || $ACTION == setup ]] \
  || fail "--with-hyprlock applies to 'setup' only"

if [[ $ACTION == status ]]; then
  show_status
  exit
fi

if [[ $ACTION == remove ]]; then
  [[ -z $DEVICE && $MODE == auto && $ENROLL_FINGERPRINT == false && $CONFIRM_SUDO_TESTED == false ]] \
    || fail "remove only accepts --dry-run"
  require_cmd "$SUDO"
  [[ -e $MAPPING_FILE ]] || fail "no mapping exists: $MAPPING_FILE"

  work_dir=$(mktemp -d -p "${TMPDIR:-/tmp}" yubikey-auth.XXXXXX)
  chmod 700 "$work_dir"
  trap 'rm -rf -- "$work_dir"' EXIT
  run_root cat -- "$MAPPING_FILE" > "$work_dir/current-mapping"
  mapping_is_valid "$work_dir/current-mapping" \
    || fail "mapping is invalid; remove a key manually after inspecting $MAPPING_FILE"

  current_mapping=$(<"$work_dir/current-mapping")
  remaining_mapping=${current_mapping%:*}
  if [[ $remaining_mapping != "$AUTH_USER" ]]; then
    printf '%s\n' "$remaining_mapping" > "$work_dir/remaining-mapping"
    mapping_is_valid "$work_dir/remaining-mapping" || fail "remaining mapping failed validation"
  fi

  if [[ $DRY_RUN == true ]]; then
    printf 'would revoke: last registered key for %s\n' "$AUTH_USER"
    if [[ $remaining_mapping == "$AUTH_USER" ]]; then
      printf 'would remove: %s (no keys would remain)\n' "$MAPPING_FILE"
    else
      printf 'would update: %s\n' "$MAPPING_FILE"
    fi
    exit 0
  fi

  printf 'This revokes the last registered key for %s on this host.\n' "$AUTH_USER"
  read -r -p 'Type REMOVE LAST KEY to confirm: ' confirmation || fail "removal cancelled"
  [[ $confirmation == 'REMOVE LAST KEY' ]] || fail "removal cancelled"
  run_root cat -- "$MAPPING_FILE" > "$work_dir/latest-mapping" \
    || fail "mapping changed during confirmation; retry"
  cmp -s -- "$work_dir/current-mapping" "$work_dir/latest-mapping" \
    || fail "mapping changed during confirmation; retry"

  stamp=$(date +%Y%m%d-%H%M%S)
  backup_file "$MAPPING_FILE" "$stamp"
  if [[ $remaining_mapping == "$AUTH_USER" ]]; then
    run_root rm -- "$MAPPING_FILE"
    printf 'removed: %s (no registered keys remain)\n' "$MAPPING_FILE"
  else
    # Same mode the setup path installs; see the note there.
    install_file "$work_dir/remaining-mapping" "$MAPPING_FILE" 0644
    printf 'updated: %s (last registered key removed)\n' "$MAPPING_FILE"
  fi
  exit 0
fi

require_cmd "$FIDO2_TOKEN"
require_cmd "$PAMU2FCFG"
require_cmd "$SUDO"
[[ -r $TEMPLATE_DIR/sudo ]] || fail "sudo PAM template not found: $TEMPLATE_DIR/sudo"
[[ -r $TEMPLATE_DIR/doas ]] || fail "doas PAM template not found: $TEMPLATE_DIR/doas"
[[ -r $TEMPLATE_DIR/hyprlock ]] || fail "Hyprlock PAM template not found: $TEMPLATE_DIR/hyprlock"

detect_device
probe_device || fail "could not read the capabilities of $DEVICE"
requested_mode=$MODE
resolve_mode
# Report the missing sensor before the mode mismatch: with --mode auto the
# mismatch is a consequence of the missing sensor, and naming the hardware is
# the actionable half.
if [[ $ENROLL_FINGERPRINT == true ]]; then
  device_supports_option bioEnroll \
    || fail "$DEVICE has no fingerprint sensor, so there is nothing to enroll"
  [[ $MODE == bio ]] \
    || fail "--enroll-fingerprint requires --mode bio"
fi

printf 'action: %s\nuser: %s\ndevice: %s\nmode: %s\n' \
  "$ACTION" "$AUTH_USER" "$DEVICE" "$MODE"

if [[ $MODE == touch ]]; then
  printf 'Sign-in will need a touch only: no PIN, no fingerprint. A touch proves\n'
  printf 'the key is present, not who pressed it.\n'
fi

if [[ $DRY_RUN == true ]]; then
  [[ $ENROLL_FINGERPRINT == true ]] && printf 'would enroll: fingerprint\n'
  if [[ $ACTION == setup && $WITH_HYPRLOCK == true && -e $MAPPING_FILE ]]; then
    printf 'would check existing mapping: %s\n' "$MAPPING_FILE"
  else
    printf 'would update: %s\n' "$MAPPING_FILE"
  fi
  if [[ $ACTION == setup ]]; then
    printf 'would deploy: %s\nwould deploy: %s\n' "$SUDO_PAM" "$DOAS_PAM"
    if [[ $WITH_HYPRLOCK == true ]]; then
      printf 'would deploy: %s\n' "$HYPRLOCK_PAM"
    else
      printf 'would leave on password: %s\n' "$HYPRLOCK_PAM"
    fi
  fi
  exit 0
fi

work_dir=$(mktemp -d -p "${TMPDIR:-/tmp}" yubikey-auth.XXXXXX)
chmod 700 "$work_dir"
trap 'rm -rf -- "$work_dir"' EXIT

if [[ $ACTION == setup && $WITH_HYPRLOCK == true && -e $MAPPING_FILE ]]; then
  run_root cat -- "$MAPPING_FILE" > "$work_dir/current-mapping"
  if mapping_is_valid "$work_dir/current-mapping"; then
    [[ $requested_mode == auto && $ENROLL_FINGERPRINT == false ]] \
      || fail "an existing mapping cannot be re-registered; omit --mode and --enroll-fingerprint"
    printf 'Using the existing mapping: %s\n' "$MAPPING_FILE"
    stamp=$(date +%Y%m%d-%H%M%S)
    # Older setups installed this public mapping root-only. Reusing its
    # credentials still needs to make it readable by unprivileged Hyprlock.
    backup_file "$MAPPING_FILE" "$stamp"
    install_file "$work_dir/current-mapping" "$MAPPING_FILE" 0644
    if ! cmp -s -- "$TEMPLATE_DIR/sudo" "$SUDO_PAM"; then
      backup_file "$SUDO_PAM" "$stamp"
      install_file "$TEMPLATE_DIR/sudo" "$SUDO_PAM" 0644
      printf 'installed: %s\n' "$SUDO_PAM"
    fi
    if ! cmp -s -- "$TEMPLATE_DIR/doas" "$DOAS_PAM"; then
      backup_file "$DOAS_PAM" "$stamp"
      install_file "$TEMPLATE_DIR/doas" "$DOAS_PAM" 0644
      printf 'installed: %s\n' "$DOAS_PAM"
    fi
    complete_setup
    exit 0
  fi
fi

if [[ $ENROLL_FINGERPRINT == true ]]; then
  printf 'Enroll a fingerprint on %s; enter its FIDO PIN only at the local prompt.\n' "$DEVICE"
  "$FIDO2_TOKEN" -S -e "$DEVICE"
fi

# Touch-only deliberately passes neither flag: -V records "verify the user at
# every authentication" and -N records "enter the FIDO PIN at every
# authentication". If the key has a PIN set it may still ask for it once here,
# during registration; that is libfido2 unlocking the key to create the
# credential, and it does not carry over to sign-in.
registration_args=(-o "$AUTH_ORIGIN" -i "$AUTH_ORIGIN")
case $MODE in
  bio) registration_args+=(-V) ;;
  pin) registration_args+=(-N) ;;
  touch) ;;
esac

new_credential="$work_dir/new-credential"
combined_mapping="$work_dir/u2f_mappings"

if [[ $ACTION == setup ]]; then
  if [[ -e $MAPPING_FILE ]]; then
    run_root cat -- "$MAPPING_FILE" > "$work_dir/current-mapping"
    mapping_is_valid "$work_dir/current-mapping" \
      && fail "a valid mapping already exists; use '$PROGRAM add'"
  fi

  printf 'If prompted, enter the PIN already set on the key at the local prompt.\n'
  printf 'Then touch %s when it blinks to finish registration.\n' "$DEVICE"
  "$PAMU2FCFG" -u "$AUTH_USER" "${registration_args[@]}" > "$combined_mapping"
  mapping_is_valid "$combined_mapping" || fail "generated mapping failed validation"
else
  [[ -e $MAPPING_FILE ]] || fail "no mapping exists; use '$PROGRAM setup' first"
  run_root cat -- "$MAPPING_FILE" > "$work_dir/current-mapping"
  mapping_is_valid "$work_dir/current-mapping" \
    || fail "existing mapping is invalid; repair it with '$PROGRAM setup'"

  printf 'If prompted, enter the PIN already set on the key at the local prompt.\n'
  printf 'Then touch %s when it blinks to finish registration.\n' "$DEVICE"
  "$PAMU2FCFG" -n "${registration_args[@]}" > "$new_credential"
  credential_is_valid "$new_credential" || fail "generated credential failed validation"
  {
    tr -d '\n' < "$work_dir/current-mapping"
    printf ':'
    tr -d '\n' < "$new_credential"
    printf '\n'
  } > "$combined_mapping"
  mapping_is_valid "$combined_mapping" || fail "combined mapping failed validation"
fi

stamp=$(date +%Y%m%d-%H%M%S)
backup_file "$MAPPING_FILE" "$stamp"
# World-readable on purpose. The mapping holds public keys and key handles,
# which are not secrets, and hyprlock runs its whole PAM stack as the
# unprivileged user: at 0600 pam_u2f cannot open the file, so the lock screen
# falls through to the password stack with nothing in the log but a pam_unix
# failure. sudo and doas read it as root either way.
install_file "$combined_mapping" "$MAPPING_FILE" 0644
printf 'installed: %s\n' "$MAPPING_FILE"

if [[ $ACTION == add ]]; then
  printf 'Additional key registered. Test it with: sudo -k; sudo -v\n'
  exit 0
fi

# Both escalation stacks go in before the checkpoint, so the tests below cover
# whichever command is actually in use. doas is the one .zshrc's `sudo` alias
# reaches; deploying only /etc/pam.d/sudo left the key unreachable in practice.
backup_file "$SUDO_PAM" "$stamp"
install_file "$TEMPLATE_DIR/sudo" "$SUDO_PAM" 0644
printf 'installed: %s\n' "$SUDO_PAM"
backup_file "$DOAS_PAM" "$stamp"
install_file "$TEMPLATE_DIR/doas" "$DOAS_PAM" 0644
printf 'installed: %s\n' "$DOAS_PAM"
complete_setup
