#!/usr/bin/env bash
# vm-preset - create a blank libvirt VM from a preset, installed unattended.
#
#   vm-preset list
#   vm-preset [--dry-run] create PRESET [--name NAME]
#   vm-preset [--dry-run] refresh-iso PRESET
#
# create checks prerequisites, then asks through rofi for the VM name, the guest
# password (twice), and whether to install ~/.ssh/id_rsa.pub. It finds or
# downloads the install ISO, runs virt-install against qemu:///system, and opens
# the console in virt-manager. The guest user is the host $USER.
#
# win11 clones a sysprepped base image, win11-base.qcow2 in the default pool,
# which the first win11 create builds from the newest ~/Resources/ISO/Win11*.iso.
# The clone's name and user come from an answer disc that is ejected and deleted
# at the clone's first reboot. Windows takes the password only in a reversible
# encoding, so that disc holds it for the minute or two before then.
#
# The password is hashed with openssl as soon as it is read and is never written
# anywhere. Only the SHA-512 crypt hash reaches the preseed, which lives in a
# mode 0700 temporary directory that is removed once the install has started.
#
# --dry-run prints the virt-install command and the rendered answer files, with
# the hash redacted, and never calls virsh, virt-install, or the network.
set -euo pipefail

virsh_command=${VIRSH:-virsh}
virt_install_command=${VIRT_INSTALL:-virt-install}
virt_manager_command=${VIRT_MANAGER:-virt-manager}
rofi_command=${ROFI:-rofi}
notify_command=${NOTIFY_SEND:-notify-send}
curl_command=${CURL:-curl}
gpg_command=${GPG:-gpg}
systemctl_command=${SYSTEMCTL:-systemctl}
id_command=${ID_COMMAND:-id}
xorriso_command=${XORRISO:-xorriso}
swtpm_command=${SWTPM:-swtpm}
connection=qemu:///system
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/vm-presets
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/vm-presets
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
template_dir=${VM_PRESET_TEMPLATES:-$config_home/hypr/vm-presets}
ssh_key=$HOME/.ssh/id_rsa.pub
debian_cd=${VM_PRESET_DEBIAN_CD:-https://cdimage.debian.org/debian-cd/current/amd64/iso-cd}
win11_iso_dir=${VM_PRESET_WIN11_ISO_DIR:-$HOME/Resources/ISO}
win11_language=${VM_PRESET_WIN11_LANGUAGE:-en-US}
# Preset defaults are filled in by check_resources.
vcpus=${VM_PRESET_VCPUS:-}
memory=${VM_PRESET_MEMORY:-}
disk_gb=${VM_PRESET_DISK_GB:-}
poll_interval=${VM_PRESET_POLL_INTERVAL:-1}
dry_run=false
log_file=
fetched_iso=
cleanup_paths=()

if [[ ! -d $template_dir ]]; then
  template_dir=$script_dir/../vm-presets
fi

presets=(debian13 debian13-docker win11)

# Primary-key fingerprints of the Debian CD signing keys that sign release
# SHA512SUMS files (https://www.debian.org/CD/verify).
debian_cd_keys=(
  DF9B9C49EAA9298432589D76DA87E80D6294BE9B
  10460DAD76165AD81FBC0CE9988021A964E6EA7D
)

usage() {
  cat >&2 <<'EOF'
usage: vm-preset [--dry-run] COMMAND [PRESET] [--name NAME]

Commands:
  list                  show the presets
  create PRESET         prompt for a name and password, then install a new VM
  refresh-iso PRESET    download the newest install ISO into the cache

Presets: debian13, debian13-docker, win11
EOF
  exit 2
}

cleanup() {
  ((${#cleanup_paths[@]})) && rm -rf -- "${cleanup_paths[@]}"
  return 0
}
trap cleanup EXIT

notify() {
  local urgency=$1 body=$2
  "$dry_run" && return 0
  command -v "$notify_command" >/dev/null 2>&1 || return 0
  "$notify_command" --urgency="$urgency" "Virtual machines" "$body" >/dev/null 2>&1 || true
}

log() {
  printf '%s\n' "$*" >&2
  [[ -z $log_file ]] || printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log_file"
}

die() {
  log "vm-preset: $*"
  notify critical "$*"
  exit 1
}

valid_preset() {
  local candidate=$1 preset
  for preset in "${presets[@]}"; do
    [[ $candidate == "$preset" ]] && return 0
  done
  printf 'Unknown preset: %s\n' "$candidate" >&2
  exit 2
}

preset_label() {
  case $1 in
    debian13) printf 'Debian 13' ;;
    debian13-docker) printf 'Debian 13 + Docker' ;;
    win11) printf 'Windows 11' ;;
  esac
}

virsh_system() {
  LC_ALL=C "$virsh_command" -c "$connection" "$@"
}

domain_exists() {
  virsh_system dominfo "$1" >/dev/null 2>&1
}

unit_active() {
  local unit
  for unit; do
    "$systemctl_command" is-active --quiet "$unit" 2>/dev/null && return 0
  done
  return 1
}

check_prerequisites() {
  local preset=$1 missing=() command message groups network commands
  commands=("$virt_install_command" "$virsh_command" "$rofi_command" openssl
    "$curl_command" sha512sum flock)
  [[ $preset != win11 ]] || commands+=("$xorriso_command" "$swtpm_command" iconv)
  for command in "${commands[@]}"; do
    command -v "$command" >/dev/null 2>&1 || missing+=("${command##*/}")
  done
  groups=$("$id_command" -nG 2>/dev/null) || true
  [[ " $groups " == *" libvirt "* ]] || missing+=("membership in the libvirt group")
  # The monolithic libvirtd carries every driver; the modular daemons split
  # them, and virt-install needs the storage one to create the disk.
  if ! unit_active libvirtd.service libvirtd.socket; then
    unit_active virtqemud.service virtqemud.socket ||
      missing+=("virtqemud (sudo systemctl start virtqemud.socket)")
    unit_active virtstoraged.service virtstoraged.socket ||
      missing+=("virtstoraged (sudo systemctl start virtstoraged.socket)")
  fi
  if ((${#missing[@]} == 0)); then
    network=$(virsh_system net-info default 2>/dev/null) || true
    [[ $network =~ (^|$'\n')Active:\ +yes ]] ||
      missing+=("the libvirt default network (sudo virsh net-start default)")
  fi
  ((${#missing[@]} == 0)) && return 0

  message=$(printf '%s, ' "${missing[@]}")
  die "Cannot create a VM. Missing: ${message%, }."
}

acquire_lock() {
  mkdir -p -- "$state_root"
  exec 9>"$state_root/lock"
  if ! flock -n 9; then
    notify normal "VM creation already in progress."
    printf 'vm-preset: VM creation already in progress.\n' >&2
    exit 1
  fi
}

theme_file() {
  local theme
  for theme in "$config_home/rofi/lmenu.rasi" "$config_home/rofi/current-theme.rasi"; do
    [[ -f $theme ]] && { printf '%s' "$theme"; return 0; }
  done
  return 0
}

# rofi_prompt PROMPT MESSAGE [ROFI ARGS...] - rows come from stdin.
rofi_prompt() {
  local prompt=$1 message=$2 theme
  shift 2
  local args=(-dmenu -p "$prompt" -mesg "$message")
  theme=$(theme_file)
  [[ -z $theme ]] || args+=(-theme "$theme")
  "$rofi_command" "${args[@]}" "$@"
}

open_console() {
  command -v "$virt_manager_command" >/dev/null 2>&1 || return 0
  setsid "$virt_manager_command" --connect "$connection" --show-domain-console "$1" \
    </dev/null >/dev/null 2>&1 &
}

cancelled() {
  log "Cancelled; nothing was created."
  exit 0
}

next_name() {
  local preset=$1 number=1
  while domain_exists "$preset-$number"; do
    number=$((number + 1))
  done
  printf '%s-%s' "$preset" "$number"
}

valid_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]]
}

# VM names may contain "." and "_"; hostnames may not.
hostname_for() {
  local hostname=${1,,}
  hostname=${hostname//[._]/-}
  while [[ $hostname == *- ]]; do hostname=${hostname%-}; done
  printf '%s' "${hostname:0:63}"
}

guest_user() {
  local user=${USER:-$("$id_command" -un)}
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] ||
    die "The host username '$user' is not a valid Debian username."
  printf '%s' "$user"
}

host_locale() {
  local value=${VM_PRESET_LOCALE:-${LANG:-}}
  value=${value/%.utf8/.UTF-8}
  [[ $value =~ ^[a-z]{2,3}_[A-Z]{2}\.UTF-8$ ]] || value=en_US.UTF-8
  printf '%s' "$value"
}

host_keymap() {
  local value=${VM_PRESET_KEYMAP:-}
  if [[ -z $value ]] && command -v localectl >/dev/null 2>&1; then
    value=$(localectl status 2>/dev/null |
      sed -n 's/^ *X11 Layout: *//p; s/^ *VC Keymap: *//p' | head -n 1) || true
  fi
  value=${value%%,*}
  [[ $value =~ ^[a-z][a-z0-9_-]*$ ]] || value=us
  printf '%s' "$value"
}

host_timezone() {
  local value=${VM_PRESET_TIMEZONE:-}
  if [[ -z $value ]] && command -v timedatectl >/dev/null 2>&1; then
    value=$(timedatectl show --property=Timezone --value 2>/dev/null) || true
  fi
  if [[ -z $value && -L /etc/localtime ]]; then
    value=$(readlink /etc/localtime)
    value=${value#*zoneinfo/}
  fi
  [[ $value =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] || value=UTC
  printf '%s' "$value"
}

windows_locale() {
  local value
  value=$(host_locale)
  value=${value%.UTF-8}
  printf '%s' "${value/_/-}"
}

# Windows uses its own zone names; anything unlisted falls back to UTC.
windows_timezone() {
  case ${VM_PRESET_WIN11_TIMEZONE:-$(host_timezone)} in
    America/New_York|America/Detroit) printf 'Eastern Standard Time' ;;
    America/Chicago) printf 'Central Standard Time' ;;
    America/Denver) printf 'Mountain Standard Time' ;;
    America/Phoenix) printf 'US Mountain Standard Time' ;;
    America/Los_Angeles) printf 'Pacific Standard Time' ;;
    Europe/London) printf 'GMT Standard Time' ;;
    *) printf 'UTC' ;;
  esac
}

# NetBIOS names stop at 15 characters.
computer_name() {
  local name=${1:0:15}
  while [[ $name == *- ]]; do name=${name%-}; done
  printf '%s' "$name"
}

# windows_password PASSWORD ELEMENT - the unattend encoding, base64 of
# UTF-16LE(PASSWORD + ELEMENT), where ELEMENT is Password or AdministratorPassword.
windows_password() {
  printf '%s%s' "$1" "$2" | iconv -f UTF-8 -t UTF-16LE | base64 -w 0
}

# ------------------------------------------------------------------ ISO ---

win11_iso() {
  local files
  shopt -s nullglob nocaseglob
  files=("$win11_iso_dir"/win11*.iso)
  shopt -u nullglob nocaseglob
  ((${#files[@]})) || return 1
  printf '%s\n' "${files[@]}" | sort -V | tail -n 1
}

cached_iso() {
  local files iso
  shopt -s nullglob
  files=("$cache_root"/debian-13.*-amd64-netinst.iso)
  shopt -u nullglob
  ((${#files[@]})) || return 1
  iso=$(printf '%s\n' "${files[@]}" | sort -V | tail -n 1)
  [[ -f $iso.sha512 ]] || return 1
  (cd -- "$cache_root" && sha512sum --check --status -- "${iso##*/}.sha512") || return 1
  printf '%s\n' "$iso"
}

verify_signature() {
  local directory=$1 status key result=0
  if ! command -v "$gpg_command" >/dev/null 2>&1; then
    log "warning: the SHA512SUMS signature was not checked (gpg is missing)."
    notify normal "Could not check the Debian ISO signature. Continuing with the SHA-512 checksum only."
    return 0
  fi
  [[ -s $directory/SHA512SUMS.sign ]] || die "The Debian SHA512SUMS signature is missing."
  status=$("$gpg_command" --batch --status-fd 1 --verify \
    "$directory/SHA512SUMS.sign" "$directory/SHA512SUMS" 2>/dev/null) || result=$?
  if grep -q '^\[GNUPG:\] BADSIG' <<<"$status"; then
    die "The Debian SHA512SUMS signature is bad. The ISO was not downloaded."
  fi
  if grep -Eq '^\[GNUPG:\] (NODATA|EXPSIG|EXPKEYSIG|REVKEYSIG|FAILURE|ERROR)' <<<"$status"; then
    die "The Debian SHA512SUMS signature could not be verified."
  fi
  for key in "${debian_cd_keys[@]}"; do
    if ((result == 0)) && grep -Eq "^\[GNUPG:\] VALIDSIG .*$key$" <<<"$status"; then
      log "SHA512SUMS is signed by the Debian CD signing key $key."
      return 0
    fi
  done
  for key in "${debian_cd_keys[@]}"; do
    if grep -Fxq "[GNUPG:] NO_PUBKEY ${key: -16}" <<<"$status"; then
      log "warning: SHA512SUMS could not be verified; the Debian CD signing key is not in your keyring."
      notify normal "Could not verify the Debian ISO signature (the Debian CD key is not in your keyring). Continuing with the SHA-512 checksum only."
      return 0
    fi
  done
  die "The Debian SHA512SUMS signature could not be verified."
}

# Download the newest Debian 13 netinst into the cache and set fetched_iso to
# its path. A file under its final name in the cache has always passed its
# checksum. Not run in a command substitution, so the EXIT trap still removes
# the download directory when a step fails.
fetch_iso() {
  local work line iso_name
  mkdir -p -- "$cache_root"
  # qemu, running as its own user, must read the ISO.
  chmod 755 -- "$cache_root"
  work=$(mktemp -d "$cache_root/.download.XXXXXX")
  cleanup_paths+=("$work")

  "$curl_command" -fsSL --retry 3 -o "$work/SHA512SUMS" "$debian_cd/SHA512SUMS" ||
    die "Could not download SHA512SUMS from $debian_cd."
  line=$(grep -m 1 -E '^[0-9a-f]{128}  debian-13\.[0-9.]+-amd64-netinst\.iso$' \
    "$work/SHA512SUMS") || die "No Debian 13 netinst ISO is listed at $debian_cd."
  iso_name=${line##* }

  "$curl_command" -fsSL --retry 3 -o "$work/SHA512SUMS.sign" "$debian_cd/SHA512SUMS.sign" ||
    : >"$work/SHA512SUMS.sign"
  verify_signature "$work"

  if [[ -f $cache_root/$iso_name ]] &&
    (cd -- "$cache_root" && printf '%s\n' "$line" | sha512sum --check --status); then
    printf '%s\n' "$line" >"$cache_root/$iso_name.sha512"
    log "$iso_name is already cached and verified."
    fetched_iso=$cache_root/$iso_name
    return 0
  fi

  notify normal "Downloading $iso_name…"
  log "Downloading $debian_cd/$iso_name"
  "$curl_command" -fsSL --retry 3 -o "$work/$iso_name" "$debian_cd/$iso_name" ||
    die "Could not download $iso_name."
  (cd -- "$work" && printf '%s\n' "$line" | sha512sum --check --status) ||
    die "$iso_name failed its SHA-512 check and was discarded."

  chmod 644 -- "$work/$iso_name"
  mv -- "$work/$iso_name" "$cache_root/$iso_name"
  printf '%s\n' "$line" >"$cache_root/$iso_name.sha512"
  log "Cached $cache_root/$iso_name"
  fetched_iso=$cache_root/$iso_name
}

# ------------------------------------------------------------- Answers ---

# render TEMPLATE KEY=VALUE... - print TEMPLATE with each @KEY@ replaced.
render() {
  local template=$1 content pair key
  shift
  [[ -f $template ]] || die "Template not found: $template"
  content=$(<"$template")
  for pair; do
    key=${pair%%=*}
    content=${content//"@$key@"/"${pair#*=}"}
  done
  if [[ $content =~ @[A-Z_]+@ ]]; then
    die "Template $template has an unfilled placeholder ${BASH_REMATCH[0]}."
  fi
  printf '%s\n' "$content"
}

# write_answers DIR PRESET HOSTNAME USER HASH WITH_KEY
write_answers() {
  local directory=$1 preset=$2 hostname=$3 user=$4 hash=$5 with_key=$6 steps
  case $preset in
    debian13-docker) steps=$(<"$template_dir/docker.late.sh") ;;
    *) steps='# No extra steps for this preset.' ;;
  esac
  (
    umask 077
    render "$template_dir/debian13.preseed.cfg" \
      "LOCALE=$(host_locale)" "KEYMAP=$(host_keymap)" "TIMEZONE=$(host_timezone)" \
      "HOSTNAME=$hostname" "USERNAME=$user" "PASSWORD_HASH=$hash" \
      >"$directory/preseed.cfg"
    render "$template_dir/late-command.sh" "USERNAME=$user" "PRESET_STEPS=$steps" \
      >"$directory/vm-preset-late.sh"
    if "$with_key"; then
      cp -- "$ssh_key" "$directory/vm-preset-authorized_keys"
    fi
  )
}

install_command() {
  local name=$1 iso=$2 answers=$3 with_key=$4
  # shellcheck disable=SC2054 # Commas separate virt-install sub-options.
  install_args=(
    --connect "$connection"
    --name "$name"
    --osinfo debian13
    --vcpus "$vcpus"
    --memory "$memory"
    --disk "size=$disk_gb,format=qcow2,bus=virtio"
    --network network=default,model=virtio
    --location "$iso"
    --uuid "$uuid"
    --initrd-inject "$answers/preseed.cfg"
    --initrd-inject "$answers/vm-preset-late.sh"
  )
  if "$with_key"; then
    install_args+=(--initrd-inject "$answers/vm-preset-authorized_keys")
  fi
  install_args+=(--extra-args "priority=critical" --noautoconsole --wait -1)
}

# Undefine a domain this run created, with its disks but not the install ISO.
remove_domain() {
  local uuid=$1 name=$2 disks
  domain_exists "$uuid" || return 0
  disks=$(virsh_system domblklist --details "$uuid" 2>/dev/null |
    awk '$1 == "file" && $2 == "disk" { print $3 }' | paste -sd, -) || true
  virsh_system destroy "$uuid" >/dev/null 2>&1 || true
  local args=(undefine "$uuid" --nvram)
  [[ -z $disks ]] || args+=(--storage "$disks")
  if virsh_system "${args[@]}" >>"$log_file" 2>&1; then
    log "Removed the partly created VM $name."
  else
    log "warning: could not remove $name; delete it in virt-manager."
  fi
}

check_resources() {
  local value
  if [[ $1 == win11 ]]; then
    vcpus=${vcpus:-4} memory=${memory:-6144} disk_gb=${disk_gb:-100}
  else
    vcpus=${vcpus:-2} memory=${memory:-4096} disk_gb=${disk_gb:-60}
  fi
  for value in "$vcpus" "$memory" "$disk_gb"; do
    [[ $value =~ ^[1-9][0-9]*$ ]] || die "VM_PRESET_VCPUS, VM_PRESET_MEMORY and VM_PRESET_DISK_GB must be positive integers."
  done
}

dry_run_create() {
  local preset=$1 name=${2:-$1-1} user answers iso with_key=false
  valid_name "$name" || die "Invalid VM name: $name"
  user=$(guest_user)
  answers=$(mktemp -d -t vm-preset.XXXXXX)
  cleanup_paths+=("$answers")
  if [[ $preset == win11 ]]; then
    dry_run_win11 "$name" "$user" "$answers"
    return 0
  fi
  [[ -f $ssh_key ]] && with_key=true
  iso=$(cached_iso) || iso="$cache_root/debian-13.<latest>-amd64-netinst.iso"
  write_answers "$answers" "$preset" "$(hostname_for "$name")" "$user" '<redacted-hash>' "$with_key"
  install_command "$name" "$iso" "$answers" "$with_key"

  if [[ -f $iso ]]; then
    printf '# ISO: %s (cached)\n' "$iso"
  else
    printf '# ISO: download the newest Debian 13 netinst from %s\n' "$debian_cd"
  fi
  printf '%q ' "$virt_install_command" "${install_args[@]}"
  printf '\n'
  printf '\n# ---- preseed.cfg ----\n'
  cat -- "$answers/preseed.cfg"
  printf '\n# ---- vm-preset-late.sh ----\n'
  cat -- "$answers/vm-preset-late.sh"
  if "$with_key"; then
    printf '\n# ---- vm-preset-authorized_keys (from %s) ----\n' "$ssh_key"
    cat -- "$answers/vm-preset-authorized_keys"
  fi
}

create_vm() {
  local preset=$1 requested_name=${2:-} label name user password confirm secret
  local with_key=false choice iso answers install_pid status=0 uuid
  uuid=$(</proc/sys/kernel/random/uuid)
  label=$(preset_label "$preset")
  check_resources "$preset"

  if "$dry_run"; then
    dry_run_create "$preset" "$requested_name"
    return 0
  fi

  check_prerequisites "$preset"
  acquire_lock
  user=$(guest_user)

  if [[ -n $requested_name ]]; then
    name=$requested_name
  else
    name=$(printf '' | rofi_prompt 'VM name' "New $label VM" -l 0 -filter "$(next_name "$preset")") ||
      cancelled
  fi
  valid_name "$name" || die "Invalid VM name '$name'. Use letters, digits, '.', '_' and '-'."
  domain_exists "$name" && die "A VM named $name already exists. Nothing was created."

  password=$(printf '' | rofi_prompt 'Password' "Guest password for $user on $name" -l 0 -password) ||
    cancelled
  confirm=$(printf '' | rofi_prompt 'Confirm' "Type the password again" -l 0 -password) ||
    cancelled
  if [[ -z $password ]]; then
    unset password confirm
    die "The password cannot be empty. Nothing was created."
  fi
  if [[ $password != "$confirm" ]]; then
    unset password confirm
    die "The passwords did not match. Nothing was created."
  fi
  if [[ $preset == win11 ]]; then
    secret=$(windows_password "$password" Password)
  else
    secret=$(printf '%s\n' "$password" | openssl passwd -6 -stdin)
  fi
  unset password confirm

  if [[ $preset != win11 && -f $ssh_key ]]; then
    # shellcheck disable=SC2088 # The tilde is display text.
    choice=$(printf 'Yes\nNo\n' | rofi_prompt 'Install host SSH key?' \
      "~/.ssh/id_rsa.pub. Password SSH login is turned off when it is installed." -no-custom) ||
      cancelled
    [[ $choice == Yes ]] && with_key=true
  fi

  mkdir -p -- "$state_root"
  log_file=$state_root/$name.log
  : >"$log_file"
  log "Creating $name from the $preset preset as $user."

  if [[ $preset == win11 ]]; then
    create_win11 "$name" "$user" "$secret"
    return 0
  fi

  if ! iso=$(cached_iso); then
    fetch_iso
    iso=$fetched_iso
  fi
  log "Using $iso"

  answers=$(mktemp -d -t vm-preset.XXXXXX)
  cleanup_paths+=("$answers")
  write_answers "$answers" "$preset" "$(hostname_for "$name")" "$user" "$secret" "$with_key"
  unset secret
  install_command "$name" "$iso" "$answers" "$with_key"

  notify normal "Creating $name ($label)…"
  log "Running $(printf '%q ' "$virt_install_command" "${install_args[@]}")"
  "$virt_install_command" "${install_args[@]}" >>"$log_file" 2>&1 9>&- &
  install_pid=$!

  until domain_exists "$uuid"; do
    kill -0 "$install_pid" 2>/dev/null || break
    sleep "$poll_interval"
  done

  if domain_exists "$uuid"; then
    # The install initrd is built by now, so the answer files can go, and
    # another VM can be created while this one installs.
    rm -rf -- "$answers"
    exec 9>&-
    open_console "$name"
    notify normal "Installing $label in $name. The console is open in virt-manager; closing it does not stop the install."
  fi

  wait "$install_pid" || status=$?
  if ((status == 0)); then
    log "$name is installed."
    notify normal "$name is installed. Log in as $user."
    return 0
  fi

  log "virt-install exited with status $status."
  remove_domain "$uuid" "$name"
  die "Creating $name failed. See $log_file."
}

# ----------------------------------------------------------- Windows 11 ---

base_name=win11-base

base_volume() {
  virsh_system vol-path --pool default "$base_name.qcow2" 2>/dev/null
}

# render_win11 TEMPLATE OUT KEY=VALUE... - an answer file with the host locale.
render_win11() {
  local template=$1 out=$2
  shift 2
  [[ $win11_language =~ ^[a-z]{2,3}-[A-Z]{2}$ ]] ||
    die "VM_PRESET_WIN11_LANGUAGE must look like en-US."
  (
    umask 077
    render "$template_dir/$template" "UI_LANGUAGE=$win11_language" \
      "LOCALE=$(windows_locale)" "$@" >"$out"
  )
}

# answer_disc DIR ISO - burn DIR/autounattend.xml onto a disc qemu can read.
# It is 0644 in the cache only until the guest's next reboot.
answer_disc() {
  mkdir -p -- "$cache_root"
  chmod 755 -- "$cache_root"
  cleanup_paths+=("$2")
  (umask 022 && "$xorriso_command" -as mkisofs -quiet -J -r -V UNATTEND -o "$2" "$1") \
    >>"$log_file" 2>&1 || die "Could not build the Windows answer disc. See $log_file."
}

# SATA and e1000e need no drivers. The base installs offline so Store updates
# cannot break sysprep.
base_install_args() {
  local iso=$1 disc=$2 base_uuid=$3
  # shellcheck disable=SC2054 # Commas separate virt-install sub-options.
  install_args=(
    --connect "$connection" --name "$base_name" --osinfo win11
    --vcpus "$vcpus" --memory "$memory"
    --disk "size=$disk_gb,format=qcow2,bus=sata"
    --disk "path=$disc,device=cdrom,bus=sata"
    --network none --cdrom "$iso" --boot uefi --tpm emulator
    --uuid "$base_uuid" --noautoconsole --wait -1
  )
}

clone_install_args() {
  local name=$1 base=$2 disc=$3
  # shellcheck disable=SC2054 # Commas separate virt-install sub-options.
  install_args=(
    --connect "$connection" --name "$name" --osinfo win11
    --vcpus "$vcpus" --memory "$memory"
    --disk "size=$disk_gb,format=qcow2,bus=sata,backing_store=$base,backing_format=qcow2"
    --disk "path=$disc,device=cdrom,bus=sata"
    --network network=default,model=e1000e --import --boot uefi --tpm emulator
    --uuid "$uuid" --noautoconsole
  )
}

# Install Windows once, sysprep it, and keep only its disk as the base image.
build_base() {
  local iso work base_uuid admin install_pid status=0 deadline _
  iso=$(win11_iso) ||
    die "No Windows 11 ISO in $win11_iso_dir. Download one from https://www.microsoft.com/software-download/windows11 and save it there."
  domain_exists "$base_name" &&
    die "A VM named $base_name is left from an unfinished base build. Delete it and its disk in virt-manager, then try again."
  log "Building $base_name from $iso"

  base_uuid=$(</proc/sys/kernel/random/uuid)
  admin=$(openssl rand -base64 24)
  work=$(mktemp -d -t vm-preset.XXXXXX)
  cleanup_paths+=("$work")
  render_win11 win11-base.autounattend.xml "$work/autounattend.xml" \
    "ADMIN_PASSWORD=$(windows_password "$admin" AdministratorPassword)" \
    "AUTOLOGON_PASSWORD=$(windows_password "$admin" Password)"
  unset admin
  answer_disc "$work" "$cache_root/.answers-$base_uuid.iso"
  base_install_args "$iso" "$cache_root/.answers-$base_uuid.iso" "$base_uuid"

  notify normal "Building the Windows 11 base image once. This takes about 20–30 minutes; later VMs take a few."
  log "Running $(printf '%q ' "$virt_install_command" "${install_args[@]}")"
  "$virt_install_command" "${install_args[@]}" >>"$log_file" 2>&1 9>&- &
  install_pid=$!
  until domain_exists "$base_uuid"; do
    kill -0 "$install_pid" 2>/dev/null || break
    sleep "$poll_interval"
  done
  if domain_exists "$base_uuid"; then
    open_console "$base_name"
    # ponytail: blind Enter presses get past the UEFI "Press any key to boot
    # from CD" prompt; remaster the ISO with efisys_noprompt.bin if it misses.
    for _ in {1..15}; do
      virsh_system send-key "$base_uuid" KEY_ENTER >/dev/null 2>&1 || true
      sleep "$poll_interval"
    done
  fi
  wait "$install_pid" || status=$?
  if ((status != 0)); then
    log "virt-install exited with status $status."
    remove_domain "$base_uuid" "$base_name"
    die "Building the Windows 11 base image failed. See $log_file."
  fi

  # The rest of setup, the one Administrator logon, and sysprep run on their
  # own; sysprep ends by shutting the VM off.
  deadline=$((SECONDS + 7200))
  until [[ $(virsh_system domstate "$base_uuid" 2>/dev/null) == "shut off"* ]]; do
    ((SECONDS < deadline)) ||
      die "$base_name did not shut down within 2 hours, so sysprep did not finish. Check its console in virt-manager."
    sleep "$poll_interval"
  done
  # Keep the disk, drop the VM, so nothing boots and changes the base.
  virsh_system undefine "$base_uuid" --nvram >>"$log_file" 2>&1 ||
    die "Could not remove the $base_name VM definition. See $log_file."
  log "Built the $base_name.qcow2 base image."
}

create_win11() {
  local name=$1 user=$2 secret=$3 base work disc
  [[ $name != "$base_name" ]] || die "$base_name is reserved for the base image."
  base=$(base_volume) || {
    build_base
    base=$(base_volume) || die "The base image is missing after building it. See $log_file."
  }
  log "Cloning $name from $base"

  work=$(mktemp -d -t vm-preset.XXXXXX)
  cleanup_paths+=("$work")
  render_win11 win11.autounattend.xml "$work/autounattend.xml" \
    "TIMEZONE=$(windows_timezone)" "COMPUTER_NAME=$(computer_name "$(hostname_for "$name")")" \
    "USERNAME=$user" "PASSWORD=$secret"
  disc=$cache_root/.answers-$uuid.iso
  answer_disc "$work" "$disc"
  rm -rf -- "$work"
  clone_install_args "$name" "$base" "$disc"

  log "Running $(printf '%q ' "$virt_install_command" "${install_args[@]}")"
  if ! "$virt_install_command" "${install_args[@]}" >>"$log_file" 2>&1 9>&-; then
    remove_domain "$uuid" "$name"
    die "Creating $name failed. See $log_file."
  fi
  exec 9>&-
  open_console "$name"
  notify normal "Setting up $name from the Windows 11 base image. This takes a few minutes."

  # Setup caches the answer file before the reboot that ends specialize, so the
  # disc, and the password on it, can go then.
  virsh_system event --domain "$uuid" --event reboot --timeout 900 >>"$log_file" 2>&1 ||
    log "warning: $name did not report a reboot within 15 minutes; ejecting the answer disc anyway."
  virsh_system change-media "$uuid" "$disc" --eject --live --config >>"$log_file" 2>&1 ||
    log "warning: could not eject the answer disc from $name; remove its second CD drive in virt-manager."
  log "$name is finishing setup."
  notify normal "$name is finishing Windows setup. Log in as $user in a minute or two."
}

dry_run_win11() {
  local name=$1 user=$2 work=$3 iso
  iso=$(win11_iso) || iso="$win11_iso_dir/Win11_<version>_x64.iso"
  render_win11 win11-base.autounattend.xml "$work/base.xml" \
    'ADMIN_PASSWORD=<redacted-password>' 'AUTOLOGON_PASSWORD=<redacted-password>'
  render_win11 win11.autounattend.xml "$work/clone.xml" \
    "TIMEZONE=$(windows_timezone)" "COMPUTER_NAME=$(computer_name "$(hostname_for "$name")")" \
    "USERNAME=$user" 'PASSWORD=<redacted-password>'

  printf '# Only when %s.qcow2 is missing: build the base from %s\n' "$base_name" "$iso"
  base_install_args "$iso" "$cache_root/.answers-<base-uuid>.iso" '<base-uuid>'
  printf '%q ' "$virt_install_command" "${install_args[@]}"
  printf '\n\n# ---- base autounattend.xml ----\n'
  cat -- "$work/base.xml"
  printf '\n# Clone %s\n' "$name"
  clone_install_args "$name" "/var/lib/libvirt/images/$base_name.qcow2" "$cache_root/.answers-$uuid.iso"
  printf '%q ' "$virt_install_command" "${install_args[@]}"
  printf '\n\n# ---- clone autounattend.xml ----\n'
  cat -- "$work/clone.xml"
}

refresh_iso() {
  [[ $preset != win11 ]] ||
    die "Windows 11 ISOs are not downloaded automatically. Save one in $win11_iso_dir."
  if "$dry_run"; then
    printf '# Download the newest Debian 13 netinst from %s into %s\n' "$debian_cd" "$cache_root"
    return 0
  fi
  command -v "$curl_command" >/dev/null 2>&1 || die "curl is required to download the ISO."
  acquire_lock
  fetch_iso
  notify normal "Debian 13 ISO ready: ${fetched_iso##*/}"
  printf '%s\n' "$fetched_iso"
}

while (($#)); do
  case $1 in
    --dry-run) dry_run=true; shift ;;
    --help|-h) usage ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done

command=${1:-}
preset=${2:-}
case $command in
  list)
    for preset in "${presets[@]}"; do
      printf '%-16s %s\n' "$preset" "$(preset_label "$preset")"
    done
    ;;
  create)
    [[ -n $preset ]] || usage
    valid_preset "$preset"
    name=
    if (($# > 2)); then
      [[ $3 == --name && -n ${4:-} && $# -eq 4 ]] || usage
      name=$4
    fi
    create_vm "$preset" "$name"
    ;;
  refresh-iso)
    [[ -n $preset && $# -eq 2 ]] || usage
    valid_preset "$preset"
    refresh_iso
    ;;
  *) usage ;;
esac
