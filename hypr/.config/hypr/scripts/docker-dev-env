#!/usr/bin/env bash
set -euo pipefail

docker_command=${DOCKER:-docker}
notify_command=${NOTIFY_SEND:-notify-send}
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/docker-dev-env
environment_file=${DOCKER_DEV_ENV_FILE:-$state_root/environment.env}
project_name=${DOCKER_DEV_PROJECT:-dotfiles-dev}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
compose_file=${DOCKER_DEV_COMPOSE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/docker-dev-env/compose.yaml}
dry_run=false

if [[ ! -f $compose_file ]]; then
  compose_file=$script_dir/../docker-dev-env/compose.yaml
fi

services=(mysql postgres mariadb redis)

usage() {
  cat >&2 <<'EOF'
usage: docker-dev-env [--dry-run] COMMAND [SERVICE]

Commands:
  up SERVICE       create and start a development service
  down SERVICE     stop a development service without deleting its data
  toggle SERVICE   start a stopped service or stop a running one
  status SERVICE   print running or stopped
  list             show every service and its state
  info [SERVICE]   print local connection URLs
  logs SERVICE     follow the last 100 log lines
  stop-all         stop and remove all service containers, preserving volumes
EOF
  exit 2
}

notify() {
  local urgency=$1 summary=$2 body=$3
  command -v "$notify_command" >/dev/null 2>&1 || return 0
  "$notify_command" --urgency="$urgency" "$summary" "$body" >/dev/null 2>&1 || true
}

valid_service() {
  local candidate=$1 service
  for service in "${services[@]}"; do
    [[ $candidate == "$service" ]] && return 0
  done
  printf 'Unknown development service: %s\n' "$candidate" >&2
  return 2
}

display_name() {
  case $1 in
    mysql) printf 'MySQL' ;;
    postgres) printf 'PostgreSQL' ;;
    mariadb) printf 'MariaDB' ;;
    redis) printf 'Redis' ;;
  esac
}

compose_command() {
  printf '%q ' "$docker_command" compose --project-name "$project_name" \
    --env-file "$environment_file" --file "$compose_file" "$@"
  printf '\n'
}

run_compose() {
  "$docker_command" compose --project-name "$project_name" \
    --env-file "$environment_file" --file "$compose_file" "$@"
}

require_docker() {
  [[ -f $compose_file ]] || { printf 'Compose template not found: %s\n' "$compose_file" >&2; return 1; }
  command -v "$docker_command" >/dev/null 2>&1 || { printf 'Docker is not installed.\n' >&2; return 1; }
  "$docker_command" compose version >/dev/null 2>&1 || { printf 'Docker Compose is not available.\n' >&2; return 1; }
  "$docker_command" info >/dev/null 2>&1 || { printf 'Docker is not running or this user cannot access it.\n' >&2; return 1; }
}

random_secret() {
  openssl rand -hex 18
}

ensure_environment() {
  [[ -f $environment_file ]] && return 0
  command -v openssl >/dev/null 2>&1 || { printf 'openssl is required to generate development credentials.\n' >&2; return 1; }

  local temporary
  mkdir -p -- "$(dirname -- "$environment_file")"
  umask 077
  temporary=$(mktemp "$(dirname -- "$environment_file")/.environment.XXXXXX")
  {
    printf 'MYSQL_DATABASE=development\n'
    printf 'MYSQL_USER=developer\n'
    printf 'MYSQL_PASSWORD=%s\n' "$(random_secret)"
    printf 'MYSQL_ROOT_PASSWORD=%s\n' "$(random_secret)"
    printf 'MYSQL_PORT=3306\n'
    printf 'POSTGRES_DB=development\n'
    printf 'POSTGRES_USER=developer\n'
    printf 'POSTGRES_PASSWORD=%s\n' "$(random_secret)"
    printf 'POSTGRES_PORT=5432\n'
    printf 'MARIADB_DATABASE=development\n'
    printf 'MARIADB_USER=developer\n'
    printf 'MARIADB_PASSWORD=%s\n' "$(random_secret)"
    printf 'MARIADB_ROOT_PASSWORD=%s\n' "$(random_secret)"
    printf 'MARIADB_PORT=3307\n'
    printf 'REDIS_PASSWORD=%s\n' "$(random_secret)"
    printf 'REDIS_PORT=6379\n'
  } >"$temporary"
  chmod 600 "$temporary"
  mv -- "$temporary" "$environment_file"
}

environment_value() {
  local key=$1
  sed -n "s/^${key}=//p" "$environment_file" | head -n 1
}

service_running() {
  local service=$1
  [[ -f $environment_file && -f $compose_file ]] || return 1
  command -v "$docker_command" >/dev/null 2>&1 || return 1
  "$docker_command" compose --project-name "$project_name" \
    --env-file "$environment_file" --file "$compose_file" \
    ps --status running --services "$service" 2>/dev/null | grep -Fxq "$service"
}

start_service() {
  local service=$1 name
  valid_service "$service"
  name=$(display_name "$service")
  if "$dry_run"; then
    [[ -f $environment_file ]] || printf 'create %s with mode 600\n' "$environment_file"
    compose_command up --detach --wait --wait-timeout 90 "$service"
    return 0
  fi
  require_docker
  ensure_environment
  notify normal "Development environment" "Starting $name…"
  if ! run_compose up --detach --wait --wait-timeout 90 "$service"; then
    notify critical "Development environment" "$name failed to start. Run docker-dev-env up $service in a terminal for details."
    return 1
  fi
  notify normal "Development environment" "$name is ready on localhost."
}

stop_service() {
  local service=$1 name
  valid_service "$service"
  name=$(display_name "$service")
  if "$dry_run"; then
    compose_command stop "$service"
    return 0
  fi
  require_docker
  [[ -f $environment_file ]] || return 0
  run_compose stop "$service"
  notify normal "Development environment" "$name stopped. Its data was preserved."
}

print_info() {
  local requested=${1:-all} service password port
  [[ -f $environment_file ]] || { printf 'No development environment credentials exist yet.\n' >&2; return 1; }
  [[ $requested == all ]] || valid_service "$requested"

  for service in "${services[@]}"; do
    [[ $requested == all || $requested == "$service" ]] || continue
    case $service in
      mysql)
        password=$(environment_value MYSQL_PASSWORD); port=$(environment_value MYSQL_PORT)
        printf 'MySQL:     mysql://developer:%s@127.0.0.1:%s/development\n' "$password" "$port"
        ;;
      postgres)
        password=$(environment_value POSTGRES_PASSWORD); port=$(environment_value POSTGRES_PORT)
        printf 'PostgreSQL: postgresql://developer:%s@127.0.0.1:%s/development\n' "$password" "$port"
        ;;
      mariadb)
        password=$(environment_value MARIADB_PASSWORD); port=$(environment_value MARIADB_PORT)
        printf 'MariaDB:   mysql://developer:%s@127.0.0.1:%s/development\n' "$password" "$port"
        ;;
      redis)
        password=$(environment_value REDIS_PASSWORD); port=$(environment_value REDIS_PORT)
        printf 'Redis:     redis://:%s@127.0.0.1:%s/0\n' "$password" "$port"
        ;;
    esac
  done
}

while (($#)); do
  case $1 in
    --dry-run) dry_run=true; shift ;;
    --help|-h) usage ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done

command=${1:-}
service=${2:-}
case $command in
  up) [[ -n $service ]] || usage; start_service "$service" ;;
  down) [[ -n $service ]] || usage; stop_service "$service" ;;
  toggle)
    [[ -n $service ]] || usage
    valid_service "$service"
    if service_running "$service"; then stop_service "$service"; else start_service "$service"; fi
    ;;
  status)
    [[ -n $service ]] || usage
    valid_service "$service"
    if service_running "$service"; then printf 'running\n'; else printf 'stopped\n'; exit 1; fi
    ;;
  list)
    for service in "${services[@]}"; do
      if service_running "$service"; then printf '%-10s running\n' "$service"; else printf '%-10s stopped\n' "$service"; fi
    done
    ;;
  info) print_info "${service:-all}" ;;
  logs)
    [[ -n $service ]] || usage
    valid_service "$service"
    require_docker
    [[ -f $environment_file ]] || { printf 'Start the service before viewing logs.\n' >&2; exit 1; }
    run_compose logs --follow --tail 100 "$service"
    ;;
  stop-all)
    if "$dry_run"; then compose_command down; exit 0; fi
    require_docker
    [[ -f $environment_file ]] || exit 0
    run_compose down
    notify normal "Development environment" "All development containers stopped. Data volumes were preserved."
    ;;
  *) usage ;;
esac
