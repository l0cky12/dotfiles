#!/usr/bin/env python3
"""Build fixture-safe, reconciled records for the Quickshell keybind palette."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Any


STATIC_BINDINGS = (
    {"modmask": 9, "key": "L", "keycode": 0,
     "description": "copy URL from web app", "dispatcher": "sendshortcut",
     "arg": "SHIFT ALT,L,activewindow", "mouse": False, "static": True},
    {"modmask": 9, "key": "D", "keycode": 0,
     "description": "download video from web app", "dispatcher": "sendshortcut",
     "arg": "SHIFT ALT,D,activewindow", "mouse": False, "static": True},
)

# X11/XKB codes. A compiled active keymap replaces these values when available.
KEYCODE_FALLBACKS = {
    9: "ESCAPE", 10: "1", 11: "2", 12: "3", 13: "4", 14: "5",
    15: "6", 16: "7", 17: "8", 18: "9", 19: "0", 20: "-", 21: "=",
    22: "BACKSPACE", 23: "TAB", 34: "[", 35: "]", 36: "RETURN",
    47: ";", 48: "'", 49: "`", 51: "\\", 59: ",", 60: ".", 61: "/",
    65: "SPACE", 67: "F1", 68: "F2", 69: "F3", 70: "F4", 71: "F5",
    72: "F6", 73: "F7", 74: "F8", 75: "F9", 76: "F10", 95: "F11",
    96: "F12", 104: "ENTER", 110: "HOME", 111: "UP", 112: "PAGE UP",
    113: "LEFT", 114: "RIGHT", 115: "END", 116: "DOWN", 117: "PAGE DOWN",
    118: "INSERT", 119: "DELETE",
}
for offset, letter in enumerate("QWERTYUIOP", 24):
    KEYCODE_FALLBACKS[offset] = letter
for offset, letter in enumerate("ASDFGHJKL", 38):
    KEYCODE_FALLBACKS[offset] = letter
for offset, letter in enumerate("ZXCVBNM", 52):
    KEYCODE_FALLBACKS[offset] = letter

# Mirrors KeybindsState's first-match essentials ladder for --dry-run evidence.
PRIORITY = (
    r"^keybindings$", r"^application launcher$", r"^terminal$", r"^browser$",
    r"^files$", r"^lmenu root$", r"^power menu$", r"^theme picker$",
    r"fullscreen", r"maximize", r"^close window$", r"close all windows",
    r"lock screen", r"floating / tiling", r"^split ", r"coding agent",
    r"^universal (copy|cut|paste)$", r"clipboard history",
    r"audio panel|volume|mute|^play / pause$|^pause$|^(next|previous) track$|"
    r"stop playback|spotify|\bmedia\b",
    r"bluetooth", r"wi-?fi|network", r"emoji", r"colour picker", r"screenshot",
    r"screen recording", r"calculator", r"drop-down terminal", r"web app manager",
    r"files here", r"^(next|previous|former) workspace$", r"^workspace [0-9]+$",
    r"^move to workspace", r"^move silently to workspace", r"swap window",
    r"^focus ", r"move window", r"resize|expand window|shrink window",
    r"notification", r"window transparency", r"window gaps", r"night light",
    r"stay awake", r"screensaver", r"power profile",
)


def run(command: list[str], environment: dict[str, str] | None = None) -> str:
    return subprocess.run(command, check=True, text=True, capture_output=True,
                          stdin=subprocess.DEVNULL, timeout=15,
                          env=environment).stdout


def read_binds(path: str | None) -> tuple[list[dict[str, Any]], str]:
    raw = Path(path).read_text(encoding="utf-8") if path else run(["hyprctl", "binds", "-j"])
    binds = json.loads(raw)
    if not isinstance(binds, list) or not binds:
        raise ValueError("Hyprland reported no bindings")
    return binds, raw


def keymap_summary(path: str | None) -> str:
    if path:
        return Path(path).read_text(encoding="utf-8")
    parts = [f"{name}={os.environ.get(name, '')}" for name in
             ("XKB_DEFAULT_RULES", "XKB_DEFAULT_MODEL", "XKB_DEFAULT_LAYOUT",
              "XKB_DEFAULT_VARIANT", "XKB_DEFAULT_OPTIONS")]
    try:
        devices = run(["hyprctl", "devices", "-j"])
        parsed = json.loads(devices)
        for keyboard in parsed.get("keyboards", []):
            parts.append(f"{keyboard.get('name', '')}:{keyboard.get('active_keymap', '')}")
    except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError):
        if shutil.which("kbctl"):
            try:
                parts.append(run(["kbctl", "list"]))
            except (OSError, subprocess.SubprocessError):
                pass
    return "\n".join(parts)


def compiled_keycodes() -> dict[int, str]:
    names: dict[str, int] = {}
    symbols: dict[str, str] = {}
    if not shutil.which("xkbcli"):
        return {}
    try:
        output = run(["xkbcli", "compile-keymap"])
    except (OSError, subprocess.SubprocessError):
        return {}
    section = ""
    for line in output.splitlines():
        if "xkb_keycodes" in line:
            section = "codes"
        elif "xkb_symbols" in line:
            section = "symbols"
        elif section == "codes":
            match = re.search(r"<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;", line)
            if match:
                names[match.group(1)] = int(match.group(2))
        elif section == "symbols":
            match = re.search(r"key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^,\s\]]+)", line)
            if match and match.group(2) != "NoSymbol":
                symbols[match.group(1)] = match.group(2)
    aliases = {"grave": "`", "minus": "-", "equal": "=", "comma": ",",
               "period": ".", "slash": "/", "semicolon": ";",
               "apostrophe": "'", "bracketleft": "[", "bracketright": "]",
               "backslash": "\\", "space": "SPACE", "Return": "RETURN"}
    return {code: aliases.get(symbols[name], symbols[name].upper())
            for name, code in names.items() if name in symbols}


def replay(path: str | None, keybindings: Path, hypr_root: Path) -> list[dict[str, Any]]:
    if path:
        value = json.loads(Path(path).read_text(encoding="utf-8"))
    else:
        lua = next((binary for binary in ("lua", "lua5.4", "lua5.3")
                    if shutil.which(binary)), None)
        nvim = shutil.which("nvim")
        if not lua and not nvim:
            raise RuntimeError("Lua replay requires lua or nvim")
        harness = Path(__file__).with_name("keybinds-replay.lua")
        command = ([lua, str(harness), str(keybindings), str(hypr_root)] if lua else
                   [nvim, "--headless", "-u", "NONE", "-l", str(harness),
                    str(keybindings), str(hypr_root)])
        environment = None
        if not lua:
            environment = os.environ.copy()
            environment["NVIM_LOG_FILE"] = os.devnull
        value = json.loads(run(command, environment))
    return value if isinstance(value, list) else []


def display_key(bind: dict[str, Any]) -> str:
    key = str(bind.get("key") or "").strip()
    if " + " in key:
        key = key.rsplit(" + ", 1)[1].strip()
    if not key and int(bind.get("keycode") or 0):
        key = f"code:{int(bind['keycode'])}"
    return key


def normalized_key(bind: dict[str, Any]) -> str:
    return display_key(bind).lower()


def reconcile(binds: list[dict[str, Any]], replayed: list[dict[str, Any]]) -> list[dict[str, Any]]:
    recovered: dict[tuple[int, str, str], list[dict[str, Any]]] = {}
    for item in replayed:
        identity = (int(item.get("modmask") or 0),
                    str(item.get("description") or "").strip().lower(),
                    normalized_key(item))
        recovered.setdefault(identity, []).append(item)

    result: list[dict[str, Any]] = []
    for original in binds:
        bind = dict(original)
        key = normalized_key(bind)
        if key:
            # Lua binds may report the whole "SUPER + code:N" chord in key;
            # modmask already owns the modifiers, so retain only the final key.
            bind["key"] = display_key(bind)
        if bind.get("dispatcher") == "__lua":
            identity = (int(bind.get("modmask") or 0),
                        str(bind.get("description") or "").strip().lower(), key)
            choices = recovered.get(identity, [])
            if choices:
                item = choices.pop(0)
                if item.get("dispatcher"):
                    bind["dispatcher"] = item["dispatcher"]
                    bind["arg"] = item.get("arg", "")
        result.append(bind)
    result.extend(dict(item) for item in STATIC_BINDINGS)
    return result


def add_key_labels(records: list[dict[str, Any]]) -> None:
    names = dict(KEYCODE_FALLBACKS)
    names.update(compiled_keycodes())
    for record in records:
        key = normalized_key(record)
        match = re.fullmatch(r"code:(\d+)", key)
        if match:
            code = int(match.group(1))
            record["key_label"] = names.get(code, f"code:{code}")


def rank(description: str) -> int:
    for index, pattern in enumerate(PRIORITY):
        if re.search(pattern, description, re.IGNORECASE):
            return index
    return 999


def cache_path(cache_home: Path, digest: str) -> Path:
    return cache_home / f"keybindings-{digest}.records"


def load_cache(path: Path) -> list[dict[str, Any]] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, list) and value else None
    except (OSError, ValueError, json.JSONDecodeError):
        return None


def write_cache(path: Path, records: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix="keybindings-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(records, handle, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def parse_args() -> argparse.Namespace:
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser()
    parser.add_argument("--binds-json", help="fixture hyprctl binds JSON")
    parser.add_argument("--replay-json", help="fixture Lua replay JSON")
    parser.add_argument("--keymap-summary", help="fixture active-keymap summary")
    parser.add_argument("--keybindings", type=Path, default=root / "conf/keybindings.lua")
    parser.add_argument("--cache-home", type=Path)
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--debug", action="store_true")
    parser.add_argument("--dry-run", action="store_true",
                        help="fixture-safe, human-readable output; never writes cache")
    parser.add_argument("--limit", type=int, default=0)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    binds, raw = read_binds(args.binds_json)
    summary = keymap_summary(args.keymap_summary)
    digest = hashlib.sha256((summary + "\n" + raw).encode()).hexdigest()
    cache_home = args.cache_home or Path(os.environ.get(
        "XDG_CACHE_HOME", str(Path.home() / ".cache")))
    target = cache_path(cache_home, digest)
    records = None if args.no_cache or args.dry_run else load_cache(target)
    if records is not None and args.debug:
        print(f"cache hit: {target}", file=sys.stderr)
    if records is None:
        hypr_root = args.keybindings.resolve().parent.parent
        records = reconcile(binds, replay(args.replay_json, args.keybindings, hypr_root))
        add_key_labels(records)
        if not args.no_cache and not args.dry_run:
            try:
                write_cache(target, records)
            except OSError as error:
                if args.debug:
                    print(f"cache write skipped: {error}", file=sys.stderr)
        if args.debug:
            print(f"cache rebuild: {target}", file=sys.stderr)

    if args.dry_run:
        ordered = sorted(records, key=lambda item: (
            rank(str(item.get("description") or "")),
            str(item.get("description") or "").lower()))
        if args.limit > 0:
            ordered = ordered[:args.limit]
        for item in ordered:
            key = item.get("key_label") or item.get("key") or f"code:{item.get('keycode', 0)}"
            print(f"{int(item.get('modmask') or 0):>2}  {key:<14}  "
                  f"{str(item.get('description') or ''):<48}  "
                  f"{item.get('dispatcher', '')} {item.get('arg', '')}".rstrip())
    else:
        json.dump(records, sys.stdout, separators=(",", ":"))
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError,
            ValueError, json.JSONDecodeError) as error:
        print(f"keybinds collector: {error}", file=sys.stderr)
        raise SystemExit(1)
