#!/usr/bin/env bash

set -u

count_lines() {
  local line count=0

  while IFS= read -r line; do
    [[ -n $line ]] && ((count += 1))
  done <<< "$1"
  printf '%d' "$count"
}

package_names_json() {
  local output=$1 line package escaped first=1

  printf '['
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -n $line ]] || continue
    package=${line%%[[:space:]]*}
    escaped=${package//\\\\/\\\\\\\\}
    escaped=${escaped//\"/\\\"}
    escaped=${escaped//$'\n'/\\n}
    escaped=${escaped//$'\r'/\\r}
    escaped=${escaped//$'\t'/\\t}
    (( first )) || printf ','
    printf '"%s"' "$escaped"
    first=0
  done <<< "$output"
  printf ']'
}

# checkupdates exits 2 when the sync succeeded and nothing is outdated, and
# 1 when it could not sync at all. Collapsing both to 0 made the bar claim the
# system was up to date whenever the network was down, so a failed sync is
# reported as an error instead and the caller keeps its last known count.
repo_updates() {
  local output status

  command -v checkupdates >/dev/null 2>&1 || return 0
  output=$(checkupdates 2>/dev/null)
  status=$?
  case $status in
    0) printf '%s' "$output" ;;
    2) return 0 ;;
    *) return 1 ;;
  esac
}

# AUR helpers exit non-zero when there is simply nothing to upgrade, so their
# status carries no signal; only the output is counted.
aur_updates() {
  local helper output status

  helper=$1
  output=$("$helper" -Qua 2>&1)
  status=$?
  if ((status != 0)) && [[ $output == *"status 429"* ]]; then
    return 2
  fi
  printf '%s' "$output"
}

aur_helper() {
  if command -v yay >/dev/null 2>&1; then
    command -v yay
  elif command -v paru >/dev/null 2>&1; then
    command -v paru
  else
    return 1
  fi
}

print_count() {
  local helper repo_output aur_output='' repo aur

  if ! repo_output=$(repo_updates); then
    printf '{"error":"sync failed"}\n' >&2
    return 1
  fi
  if helper=$(aur_helper); then
    if ! aur_output=$(aur_updates "$helper"); then
      printf '{"error":"AUR check rate limited"}\n' >&2
      return 1
    fi
  fi
  repo=$(count_lines "$repo_output")
  aur=$(count_lines "$aur_output")
  printf '{"repo":%d,"aur":%d,"total":%d,"repoPackages":%s,"aurPackages":%s}\n' \
    "$repo" "$aur" "$((repo + aur))" \
    "$(package_names_json "$repo_output")" "$(package_names_json "$aur_output")"
}

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "System Update" "$1"
  printf '%s\n' "$1" >&2
}

# The AUR helper doubles as the Arch upgrade path; apt covers the Debian boxes.
# Neither branch is reachable on the other distro, so both are asserted in
# tests/arch-updates.test.sh rather than only on whichever machine runs this.
update_command() {
  local helper

  if helper=$(aur_helper); then
    printf '%s -Syu' "$helper"
    return 0
  fi
  if command -v apt >/dev/null 2>&1; then
    printf 'sudo apt update && sudo apt full-upgrade'
    return 0
  fi
  return 1
}

terminal() {
  local candidate

  for candidate in "${TERMINAL:-}" kitty foot alacritty ghostty; do
    [[ -n $candidate ]] || continue
    command -v "$candidate" >/dev/null 2>&1 && { command -v "$candidate"; return 0; }
  done
  return 1
}

# The upgrade needs an interactive terminal so sudo and the AUR helper can
# prompt, and the window is held open on a read so the log stays readable.
# Exiting with the upgrade's status lets the widget tell "finished" from
# "failed" instead of zeroing its count either way.
# ponytail: relies on the terminal forwarding the child exit code; if one does
# not, the widget just keeps its counts and flags them stale.
run_update() {
  local term command

  if ! command=$(update_command); then
    notify "Install yay, paru, or apt to update."
    return 1
  fi
  if ! term=$(terminal); then
    notify "No terminal emulator found."
    return 1
  fi

  "$term" --title "System Update" bash -lc '
    eval "$1"
    status=$?
    printf "\n"
    read -rp "Done. Press Enter to close. " _
    exit $status
  ' _ "$command"
}

case ${1:-count} in
  update) run_update ;;
  *) print_count ;;
esac
