{
  "name": "Dotfiles — {{ theme_name }}",
  "appearance": "{{ theme_mode }}",
  "canvas": "{{ background }}",
  "accent": "{{ accent }}",
  "colors": {
    "chrome": "{{ background_alt }}",
    "toolbar": "{{ background_alt }}",
    "toolbarForeground": "{{ foreground_bright }}",
    "toolbarBorder": "{{ border }}",
    "toolbarControl": "{{ surface }}",
    "toolbarControlForeground": "{{ foreground }}",
    "toolbarControlHover": "{{ surface_alt }}",
    "surface": "{{ surface }}",
    "surfaceRaised": "{{ surface_alt }}",
    "surfaceOverlay": "{{ overlay }}",
    "text": "{{ foreground_bright }}",
    "textMuted": "{{ muted }}",
    "border": "{{ border }}",
    "input": "{{ border_active }}",
    "focus": "{{ accent }}",
    "accentForeground": "{{ fg_on(accent) }}",
    "secondary": "{{ surface_alt }}",
    "secondaryForeground": "{{ foreground }}",
    "muted": "{{ surface }}",
    "mutedForeground": "{{ muted }}",
    "placeholder": "{{ disabled }}",
    "secondaryLabel": "{{ muted }}",
    "iconMuted": "{{ muted }}",
    "error": "{{ critical }}",
    "errorForeground": "{{ fg_on(critical) }}",
    "errorSurface": "{{ mix(background, critical, 0.16) }}",
    "warning": "{{ warning }}",
    "warningForeground": "{{ fg_on(warning) }}",
    "warningSurface": "{{ mix(background, warning, 0.16) }}",
    "update": "{{ info }}",
    "updateForeground": "{{ fg_on(info) }}",
    "updateSurface": "{{ mix(background, info, 0.16) }}",
    "accentSurface": "{{ mix(background, accent, 0.18) }}",
    "accentSurfaceForeground": "{{ foreground_bright }}",
    "messageSurface": "{{ surface }}",
    "messageForeground": "{{ foreground_bright }}",
    "messageAction": "{{ accent }}",
    "messageActionForeground": "{{ fg_on(accent) }}",
    "messageActionHover": "{{ accent_alt }}",
    "codeBackground": "{{ background_alt }}",
    "codeForeground": "{{ foreground }}",
    "sidebar": "{{ background_alt }}",
    "sidebarForeground": "{{ foreground_bright }}",
    "sidebarMutedForeground": "{{ muted }}",
    "sidebarControlSurface": "{{ surface }}",
    "sidebarRowHover": "{{ surface }}",
    "sidebarRowActive": "{{ surface_alt }}",
    "sidebarRowSelected": "{{ selection }}",
    "sidebarBorder": "{{ border }}",
    "terminalBackground": "{{ background }}",
    "terminalForeground": "{{ foreground }}",
    "terminalCursor": "{{ accent }}",
    "terminalSelection": "{{ selection }}",
    "terminalScrollbar": "{{ border }}",
    "terminalScrollbarHover": "{{ border_active }}"
  }
}
