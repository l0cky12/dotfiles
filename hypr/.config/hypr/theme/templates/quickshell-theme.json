{
  "_generated": "from themes/{{ theme_slug }}/colors.toml — do not edit",
  "theme": {
    "name": {{ json_str(theme_name) }},
    "slug": {{ json_str(theme_slug) }},
    "mode": {{ json_str(theme_mode) }},
    "description": {{ json_str(theme_description) }},
    "family": {{ json_str(theme_family) }},
    "wallpaper": {{ json_str(theme_wallpaper) }}
  },
  "colors": {
    "background": "{{ background }}",
    "backgroundAlt": "{{ background_alt }}",
    "surface": "{{ surface }}",
    "surfaceAlt": "{{ surface_alt }}",
    "overlay": "{{ overlay }}",
    "foreground": "{{ foreground }}",
    "foregroundBright": "{{ foreground_bright }}",
    "muted": "{{ muted }}",
    "disabled": "{{ disabled }}",
    "accent": "{{ accent }}",
    "accentAlt": "{{ accent_alt }}",
    "onAccent": "{{ fg_on(accent) }}",
    "red": "{{ red }}",
    "green": "{{ green }}",
    "yellow": "{{ yellow }}",
    "blue": "{{ blue }}",
    "magenta": "{{ magenta }}",
    "cyan": "{{ cyan }}",
    "selection": "{{ selection }}",
    "border": "{{ border }}",
    "borderActive": "{{ border_active }}",
    "urgent": "{{ urgent }}",
    "shadow": "{{ shadow }}",
    "success": "{{ success }}",
    "warning": "{{ warning }}",
    "critical": "{{ critical }}",
    "info": "{{ info }}"
  },
  "ansi": {
    "black": "{{ ansi.black }}",
    "red": "{{ ansi.red }}",
    "green": "{{ ansi.green }}",
    "yellow": "{{ ansi.yellow }}",
    "blue": "{{ ansi.blue }}",
    "magenta": "{{ ansi.magenta }}",
    "cyan": "{{ ansi.cyan }}",
    "white": "{{ ansi.white }}",
    "brightBlack": "{{ ansi.bright_black }}",
    "brightRed": "{{ ansi.bright_red }}",
    "brightGreen": "{{ ansi.bright_green }}",
    "brightYellow": "{{ ansi.bright_yellow }}",
    "brightBlue": "{{ ansi.bright_blue }}",
    "brightMagenta": "{{ ansi.bright_magenta }}",
    "brightCyan": "{{ ansi.bright_cyan }}",
    "brightWhite": "{{ ansi.bright_white }}"
  },
  "style": {
    "rounding": {{ rounding }},
    "borderWidth": {{ border_width }},
    "surfaceOpacity": {{ surface_opacity }},
    "scrimOpacity": {{ scrim_opacity }},
    "shadowOpacity": {{ shadow_opacity }},
    "blur": {{ on(blur) }}
  }
}
