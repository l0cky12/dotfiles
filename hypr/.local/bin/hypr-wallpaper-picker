#!/usr/bin/env bash

wallpaper_dir="${HYPR_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
runtime_dir="${HYPR_WALLPAPER_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/hypr-wallpaper-picker-$UID}"
state_file="${HYPR_WALLPAPER_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-desktop/wallpaper/current}"

notify() {
    notify-send "Wallpaper picker" "$1"
}

wallhaven_dns_blocked() {
    local host
    for host in wallhaven.cc th.wallhaven.cc w.wallhaven.cc; do
        if getent ahostsv4 "$host" 2>/dev/null | \
            grep -Eq '^146\.112\.61\.(10[4-8]|110)[[:space:]]'; then
            printf '%s\n' 'Wallhaven is blocked by Cisco Umbrella DNS. Allow wallhaven.cc, th.wallhaven.cc, and w.wallhaven.cc, then retry.' >&2
            return 0
        fi
    done
    return 1
}

list_wallpapers() {
    local json
    json="$(find "$wallpaper_dir" -type f \( -iname '*.jpg' -o -iname '*.png' \) \
        -print0 2>/dev/null | sort -z -f | jq -Rs '
          split("\u0000") | map(select(length > 0)) |
          {items: map({
            kind: "local",
            slug: ., path: ., wallpaper: .,
            name: (split("/")[-1])
          })}')" || return 1
    [[ "$(jq '.items | length' <<< "$json")" != 0 ]] || \
        notify "No JPG or PNG wallpapers found"
    printf '%s\n' "$json"
}

search_wallhaven() {
    local query="$1" page="$2" response_tmp preview_tmp output_tmp ids_json
    local id thumbnail
    local -a downloaded=()

    [[ -n "${query//[[:space:]]/}" && "$page" =~ ^[1-9][0-9]*$ ]] || {
        printf 'Invalid Wallhaven query or page\n' >&2
        return 1
    }
    if wallhaven_dns_blocked; then
        notify "Wallhaven is blocked by Cisco Umbrella DNS"
        return 1
    fi

    mkdir -p "$runtime_dir"
    response_tmp="$(mktemp "$runtime_dir/response.XXXXXX")" || return 1
    preview_tmp="$(mktemp -d "$runtime_dir/previews.XXXXXX")" || {
        rm -f -- "$response_tmp"
        return 1
    }
    output_tmp="$(mktemp "$runtime_dir/output.XXXXXX")" || {
        rm -rf -- "$preview_tmp"
        rm -f -- "$response_tmp"
        return 1
    }

    notify "Searching Wallhaven for: $query (page $page)"
    if ! curl -fsSLG "https://wallhaven.cc/api/v1/search" \
        --header "Cache-Control: no-cache" \
        --data-urlencode "q=$query" \
        --data-urlencode "page=$page" \
        --data-urlencode "categories=111" \
        --data-urlencode "purity=100" \
        --data-urlencode "sorting=relevance" \
        --data-urlencode "atleast=1920x1080" \
        -o "$response_tmp"; then
        rm -rf -- "$preview_tmp"
        rm -f -- "$response_tmp" "$output_tmp"
        notify "Wallhaven search failed"
        printf 'Wallhaven search failed\n' >&2
        return 1
    fi

    if ! jq -e '.data | type == "array"' "$response_tmp" >/dev/null || \
        ! jq -e '.meta.current_page | type == "number" and . >= 1 and floor == .' \
            "$response_tmp" >/dev/null || \
        ! jq -e '.meta.last_page | type == "number" and . >= 1 and floor == .' \
            "$response_tmp" >/dev/null; then
        rm -rf -- "$preview_tmp"
        rm -f -- "$response_tmp" "$output_tmp"
        notify "Wallhaven returned an invalid response"
        printf 'Wallhaven returned an invalid response\n' >&2
        return 1
    fi

    while IFS=$'\t' read -r id thumbnail; do
        [[ -n "$id" ]] || continue
        if curl -fsSL --retry 2 -o "$preview_tmp/$id.jpg" "$thumbnail" && \
            [[ -s "$preview_tmp/$id.jpg" ]]; then
            downloaded+=("$id")
        else
            rm -f -- "$preview_tmp/$id.jpg"
        fi
    done < <(jq -r '.data[] | [.id, .thumbs.large] | @tsv' "$response_tmp")

    if ((${#downloaded[@]} == 0)); then
        rm -rf -- "$preview_tmp"
        rm -f -- "$response_tmp" "$output_tmp"
        notify "No Wallhaven results found"
        printf 'No Wallhaven results found\n' >&2
        return 1
    fi

    rm -rf -- "$runtime_dir/previews"
    mv -- "$preview_tmp" "$runtime_dir/previews"
    ids_json="$(printf '%s\n' "${downloaded[@]}" | jq -Rsc 'split("\n")[:-1]')"
    if ! jq --arg dir "$runtime_dir/previews" --argjson ids "$ids_json" '
      {
        page: .meta.current_page,
        last_page: .meta.last_page,
        items: [
          .data[] |
          select(.id as $id | $ids | index($id)) |
          {
            kind: "wallhaven",
            slug: ("wallhaven-" + .id),
            id: .id,
            name: ("wallhaven-" + .id + " · " + .resolution),
            path: .path,
            url: .path,
            wallpaper: ($dir + "/" + .id + ".jpg")
          }
        ]
      }' "$response_tmp" > "$output_tmp"; then
        rm -f -- "$response_tmp" "$output_tmp"
        notify "Wallhaven returned an invalid response"
        printf 'Wallhaven returned an invalid response\n' >&2
        return 1
    fi
    cat "$output_tmp"
    rm -f -- "$response_tmp" "$output_tmp"
}

search_wallpapers() {
    local query="$1" page="$2" local_json wallhaven_json

    local_json="$(list_wallpapers)" || return 1
    wallhaven_json="$(search_wallhaven "$query" "$page")" || return 1

    jq -n --arg query "$query" --argjson page "$page" \
        --argjson local "$local_json" --argjson wallhaven "$wallhaven_json" '
      ($query | ascii_downcase) as $needle |
      $wallhaven |
      .items = (
        (if $page == 1 then
          [$local.items[] |
            select(((.name + " " + .path) | ascii_downcase) | contains($needle))]
        else
          []
        end) + .items
      )'
}

download_wallhaven() {
    local id="$1" url="$2" extension target partial
    [[ "$id" =~ ^[[:alnum:]]+$ && "$url" == https://* ]] || {
        printf 'Invalid Wallhaven result\n' >&2
        return 1
    }

    case "${url%%\?*}" in
        *.png) extension="png" ;;
        *) extension="jpg" ;;
    esac
    target="$wallpaper_dir/wallhaven-$id.$extension"
    partial="$target.part"

    if [[ ! -s "$target" ]]; then
        if wallhaven_dns_blocked; then
            notify "Wallhaven is blocked by Cisco Umbrella DNS"
            return 1
        fi
        notify "Downloading wallhaven-$id"
        rm -f -- "$partial"
        if ! curl -fsSL --retry 2 -o "$partial" "$url" || \
            [[ ! -s "$partial" ]] || ! magick identify "$partial" >/dev/null 2>&1; then
            rm -f -- "$partial"
            notify "Wallpaper download failed"
            printf 'Wallpaper download failed\n' >&2
            return 1
        fi
        if ! mv -f -- "$partial" "$target"; then
            rm -f -- "$partial"
            notify "Wallpaper download failed"
            printf 'Wallpaper download failed\n' >&2
            return 1
        fi
    fi

    printf '%s\n' "$target"
}

ensure_hyprpaper_running() {
    if ! pgrep -x hyprpaper >/dev/null; then
        hyprpaper >/dev/null 2>&1 &
    fi
}

apply_wallpaper() {
    local wallpaper="$1"
    [[ -f "$wallpaper" ]] || {
        printf 'Wallpaper does not exist: %s\n' "$wallpaper" >&2
        return 1
    }

    # hyprpaper 0.8 loads on demand and re-points a live daemon over IPC, so it
    # must not be restarted here: hyprpaper.conf declares no wallpaper block, and
    # a fresh daemon therefore blanks every output until the handshake lands.
    ensure_hyprpaper_running
    for _ in {1..40}; do
        if hyprctl hyprpaper wallpaper ",$wallpaper,cover" >/dev/null 2>&1; then
            return
        fi
        sleep 0.05
    done

    notify "hyprpaper failed to set the wallpaper"
    printf 'hyprpaper failed to set the wallpaper\n' >&2
    return 1
}

persist_wallpaper() {
    local wallpaper="$1" state_dir tmp
    wallpaper="$(realpath -e -- "$wallpaper")" || return 1
    state_dir="$(dirname -- "$state_file")"
    mkdir -p -- "$state_dir" || return 1
    tmp="$(mktemp "$state_dir/.current.XXXXXX")" || return 1
    if ! jq -n --arg path "$wallpaper" '{path: $path}' > "$tmp" || \
        ! mv -f -- "$tmp" "$state_file"; then
        rm -f -- "$tmp"
        return 1
    fi
}

current_wallpaper() {
    local wallpaper=""
    [[ -f "$state_file" ]] || return 1
    wallpaper="$(jq -er '.path | select(type == "string" and length > 0)' \
        "$state_file" 2>/dev/null)" || return 1
    [[ -f "$wallpaper" ]] || return 1
    realpath -e -- "$wallpaper"
}

set_wallpaper() {
    local wallpaper="$1"
    apply_wallpaper "$wallpaper" || return 1
    if ! persist_wallpaper "$wallpaper"; then
        notify "Wallpaper applied, but its persistent state could not be saved"
        printf 'Wallpaper state could not be saved: %s\n' "$state_file" >&2
        return 1
    fi
}

restore_wallpaper() {
    local wallpaper=""
    if wallpaper="$(current_wallpaper)"; then
        apply_wallpaper "$wallpaper"
        return
    fi

    # No saved wallpaper is non-fatal: leave Hyprpaper running without one.
    ensure_hyprpaper_running
}

cleanup() {
    if [[ -d "$runtime_dir" ]]; then
        rm -rf -- "$runtime_dir"
    fi
}

activate_wallhaven() {
    local wallpaper
    wallpaper="$(download_wallhaven "$1" "$2")" || return 1
    set_wallpaper "$wallpaper"
}

usage() {
    printf 'usage: hypr-wallpaper-picker [index|search QUERY PAGE|apply PATH|activate ID URL|current|restore|cleanup]\n' >&2
    return 2
}

main() {
    local command="${1:-}"
    case "$command" in
        index)
            (($# == 1)) || { usage; return; }
            list_wallpapers
            ;;
        search)
            (($# == 3)) || { usage; return; }
            search_wallpapers "$2" "$3"
            ;;
        apply)
            (($# == 2)) || { usage; return; }
            set_wallpaper "$2"
            ;;
        activate)
            (($# == 3)) || { usage; return; }
            activate_wallhaven "$2" "$3"
            ;;
        current)
            (($# == 1)) || { usage; return; }
            current_wallpaper
            ;;
        restore)
            (($# == 1)) || { usage; return; }
            restore_wallpaper
            ;;
        cleanup)
            (($# == 1)) || { usage; return; }
            cleanup
            ;;
        "")
            exec quickshell ipc call wallpaper toggle
            ;;
        *) usage ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
